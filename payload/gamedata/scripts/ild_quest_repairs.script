-- WIRING (three one-line edits to the pack's own files, no game/mod file is touched):
--   1. save the block above as D:\Games\In-the-line-of-duty-fixes\payload\gamedata\scripts\ild_agro_nemo.script
--      (pure ASCII, so CP1251 and UTF-8 are byte-identical here);
--   2. in payload\gamedata\scripts\ild_gameplay.script, inside install(), after `ild_mod_repairs.install()`, add:
--          ild_agro_nemo.install()
--      X-Ray resolves an unreferenced module never, so this call is what loads the file;
--   3. add the pair
--          'gamedata/scripts/ild_agro_nemo.script' = 'payload\gamedata\scripts\ild_agro_nemo.script'
--      to the manifest in tools\deploy\Deploy-FixPack.ps1 and its '/' twin in tools\package\Build-Package.ps1,
--      beside the existing ild_gameplay.script rows.
-- ---------------------------------------------------------------------------------------------------------------

-- ---------- psy-antenna ----------
-- APPLY: append this block to payload/gamedata/scripts/ild_mod_repairs.script immediately above its existing
-- install(), and add the single call `install_psy_ceiling()` as the last line of that install(). That file is
-- already the pack's overflow script, already runs at load time next to ild_script_repairs (ild_gameplay.install()
-- chains it, and the engine reaches ild_gameplay.install() from bind_stalker's actor net_spawn via script_patch),
-- and needs no build, manifest or deploy change. The final install() is reproduced at the bottom of this block.

-- The Radar antenna field is on the only road north, and carrying Sakharov's psy helmet makes it worse instead
-- of better. The mod lowered the bare-headed rows of two restrictors in all.spawn and left their helmet rows at
-- the vanilla numbers, which were written against a bare-headed hit of 100:
--   rad_antenna_rays_and_spot  no_helmet eff 10  hit 10   bad_helmet eff 100  hit 30   good_helmet eff 100  hit 20
--   rad_space_restrictor_0008  no_helmet eff +10 hit +10  bad_helmet eff +100 hit +20  good_helmet eff +100 hit +20
-- sr_psy_antenna scales both by 0.01, so a helmet in the belt buys a 0.20-0.30 wound hit every five seconds
-- against 0.10 bare-headed, under a psi postprocess ten times stronger. The author's bare-headed row is left
-- exactly as it stands and is read back from the object's own custom_data; nothing above it is let through.
local psy_ceiling_installed = false
local psy_ceiling_section = "sr_psy_antenna@no_helmet"
-- Read from all.spawn as it ships; used only if the object arrives configured from somewhere that has no such
-- section, so that a missing baseline still cannot raise the helmet above bare-headed.
local psy_ceiling_objects = {
    ["rad_antenna_rays_and_spot"] = {eff_intensity = 10, hit_intensity = 10},
    ["rad_space_restrictor_0008"] = {eff_intensity = 10, hit_intensity = 10}
}
local psy_ceiling_reported = {}

local function psy_ceiling_read(source, field)
    if not source then return nil end
    local known, value = pcall(function()
        if source:section_exist(psy_ceiling_section) and source:line_exist(psy_ceiling_section, field) then
            return source:r_float(psy_ceiling_section, field)
        end
    end)
    if known then return value end
end

local function psy_ceiling_value(ini, object, field, fallback)
    -- Both restrictors name no cfg file, so the ini the scheme was configured from is their own custom_data and
    -- already carries the bare-headed row; the spawn ini is only a second look for a re-pointed logic file.
    local value = psy_ceiling_read(ini, field)
    if value then return value end
    local known, spawn = pcall(function() return object:spawn_ini() end)
    value = known and psy_ceiling_read(spawn, field)
    if value then return value end
    return fallback
end

local function install_psy_ceiling()
    if psy_ceiling_installed then return end
    -- Naming the module here is what makes the engine load it; a build without it has nothing to wrap.
    if not sr_psy_antenna or type(sr_psy_antenna.set_scheme) ~= "function" then return end
    psy_ceiling_installed = true
    local original = sr_psy_antenna.set_scheme
    sr_psy_antenna.set_scheme = function(object, ini, scheme, section, gulag_name)
        local result = original(object, ini, scheme, section, gulag_name)
        local known, name = pcall(function() return object:name() end)
        local limits = known and name and psy_ceiling_objects[name]
        if not limits then return result end
        -- The scheme keeps one storage table per object and rewrites it on every section switch, so the ceiling
        -- belongs where the numbers are produced rather than where zone_enter adds them up. xr_logic calls this
        -- before it issues reset_scheme, so the clamped pair is what the zone is entered with.
        local storage = db.storage and db.storage[object:id()]
        local state = storage and storage[scheme]
        if not state then return result end
        local eff = psy_ceiling_value(ini, object, "eff_intensity", limits.eff_intensity) * 0.01
        local hit = psy_ceiling_value(ini, object, "hit_intensity", limits.hit_intensity) * 0.01
        local capped = false
        if state.intensity and state.intensity > eff then state.intensity, capped = eff, true end
        if state.hit_intensity and state.hit_intensity > hit then state.hit_intensity, capped = hit, true end
        -- The section switches on every entry and exit of the field, so one line per object is all it writes.
        if capped and not psy_ceiling_reported[name] then
            psy_ceiling_reported[name] = true
            pcall(log, "ild: " .. name .. " helmet psy values capped at its no-helmet row")
        end
        return result
    end
end

-- ---------- map-and-logic-gaps ----------
-- payload/gamedata/scripts/ild_map_repairs.script
--     ild_map_repairs.install()
-- The engine loads a script module only when something names it, so without that line this file never runs.

-- Four gaps between the mod's map, its spawn and its logic files. Every repair below puts the mod's own data
-- back where the mod's own code already looks for it; nothing is invented and no original file is touched.

-- The mod parks an object it wants gone by moving it kilometres off the level rather than deleting it.
local parked_depth = 2000
local lchanger_section = "level_changer"
local lchanger_spot = "level_changer"

-- The Monolith jammer on the Military warehouses.
local jammer = {
    section = "mil_glyshilka_monolita",
    spot = "green_location",
    hint = "mtka_na_glyshky_mnlt",
    portion = "mil_gg_nashel_v_drvn_rpg",
    wanted = false,
    settled = false
}

-- Two all.spawn NPCs whose logic never arrives, keyed by the name all.spawn gives them. Each is held exactly
-- where the spawn put him, in the shape his own neighbours carry.
local missing_schemes = {
    -- gar_ammo_5.45x39_fmj_0002 is the stalker of profile gar_qrec_na_bochke - the man on the barrel whose
    -- appearance ends Qra's chain. His custom_data names scripts\mysorka\gar_qrec_na_bochke.ltx, which is in
    -- neither the loose tree nor the archives, so configure_schemes hands him an empty ini and he walks off.
    -- The two paths below are the mod's own: gar_qra_na_bochke_walk is a single waypoint at (58.0, 18.4, 96.2),
    -- his spawn position to the centimetre, and gar_qra_na_bochke_look is the point beside it. The rest is the
    -- shape every standing mysorka NPC uses, gar_stal_baraxol1.ltx included.
    ["gar_ammo_5.45x39_fmj_0002"] = {
        logic = {active = "walker", combat_ignore = "combat_ignore"},
        combat_ignore = {},
        walker = {
            path_walk = "gar_qra_na_bochke_walk",
            path_look = "gar_qra_na_bochke_look",
            def_state_standing = "sit",
            combat_ignore_cond = "always"
        }
    },
    -- bar_dolg_bunker_5 is assigned to the smart terrain bar_dolg_bunker. gulag_bar.ltx holds that gulag's job
    -- sections, but no smart_terrain object of that name is in all.spawn, so he joins nothing, carries no inline
    -- logic of his own and stands blank among the four posed guards. This is the logic his three remark
    -- neighbours - bar_dolg_bunker_1, _3 and _4 - carry in their own custom_data.
    bar_dolg_bunker_5 = {
        logic = {active = "remark", combat_ignore = "combat_ignore"},
        combat_ignore = {},
        remark = {
            anim = "patrol",
            meet = "no_meet",
            combat_ignore_cond = "{=fighting_dist_ge(10)} always"
        }
    }
}

local function parked_changer(server)
    local known, parked = pcall(function()
        return server:section_name() == lchanger_section and math.abs(server.position.y) >= parked_depth
    end)
    return known and parked
end

-- add_lchanger_location draws "to Yantar" on story object 608, exit_to_yantar_01, which the mod moved to
-- y = -15000.76 and replaced with the tunnel pair. The icon stays on the Rostok map and sends the player to a
-- transition that is not there. Every changer the mod parked the same way loses its icon; the live ones keep
-- theirs, and no other spot type is touched.
local function drop_parked_lchanger_spots()
    local simulator = alife()
    if not simulator then return end
    for id = 1, 65534 do
        local server = simulator:object(id)
        if server and parked_changer(server) then
            -- map_has_object_spot answers with a count, which is how level_tasks.remove_location_safe drains it.
            for _ = 1, level.map_has_object_spot(id, lchanger_spot) do
                level.map_remove_object_spot(id, lchanger_spot)
            end
        end
    end
end

local function jammer_id()
    local simulator = alife()
    if not simulator then return nil end
    for id = 1, 65534 do
        local server = simulator:object(id)
        local known, name = pcall(function() return server and server:section_name() end)
        if known and name == jammer.section then return id end
    end
    return nil
end

-- Placed at most once. The mod asks for this marker from two different info portions and never checks, so an
-- unconditional add would leave the player with the same icon twice over.
local function place_jammer_spot()
    local id = jammer_id()
    if not id then return false end
    if level.map_has_object_spot(id, jammer.spot) == 0 then
        level.map_add_object_spot(id, jammer.spot, jammer.hint)
    end
    return true
end

-- mil_gg_nashel_v_drvn_rpg runs skladu.metka_na_glyshilky_mnlt as its first action and
-- skladu.spawn_mil_y_strt_glyshilka_monolita eleven actions later, and info-portion actions run in file order.
-- The marker call scans the simulation for an object that does not exist yet, finds nothing and says nothing,
-- so until the much later mil_jora2_pred ydarom the player has no marker for the jammer at all. The request is
-- remembered and the creation of the jammer honours it.
local function install_jammer_spot()
    skladu.metka_na_glyshilky_mnlt = function()
        jammer.wanted = not place_jammer_spot()
    end
    local original_jammer_spawn = skladu.spawn_mil_y_strt_glyshilka_monolita
    skladu.spawn_mil_y_strt_glyshilka_monolita = function(...)
        local result = original_jammer_spawn(...)
        if jammer.wanted and place_jammer_spot() then jammer.wanted = false end
        return result
    end
end

-- A save that was granted the portion before this repair existed never got the marker either. One look per
-- level load, only once the portion is known, and only when no such spot is on the object already.
local function settle_jammer_spot()
    if jammer.settled or not db.actor or not has_alife_info(jammer.portion) then return end
    jammer.settled = true
    pcall(place_jammer_spot)
end

-- The engine can build an ini only from a file, and this pack ships no file of its own into the mod's config
-- tree. It does not have to: every reader on the scheme path is Lua, and utils.cfg_get_string, cfg_get_bool and
-- cfg_get_number between them ask an ini for exactly section_exist, line_exist and one typed read. A table that
-- answers those is a complete stand-in for the section a missing file would have held.
local function read_only_ini(sections)
    local function value(section, line)
        local fields = sections[section]
        return fields and fields[line] or nil
    end
    local ini = {}
    function ini.section_exist(_, section) return sections[section] ~= nil end
    function ini.line_exist(_, section, line) return value(section, line) ~= nil end
    function ini.line_count(_, section)
        local count = 0
        for _ in pairs(sections[section] or {}) do count = count + 1 end
        return count
    end
    function ini.r_string(_, section, line) return value(section, line) end
    function ini.r_bool(_, section, line) return value(section, line) == "true" end
    function ini.r_float(_, section, line) return tonumber(value(section, line)) or 0 end
    function ini.r_u32(_, section, line) return tonumber(value(section, line)) or 0 end
    return ini
end

-- initialize_obj is the one place both NPCs pass through: neither belongs to a smart terrain - one says
-- none = true, the other names a terrain that is not in the spawn - so setup_gulag_and_logic_on_spawn sends
-- both here. The saved ini name stays the ordinary "<customdata>" the mod writes for every inline NPC, so a
-- save made with the pack still loads without it: the mod's own path reads the spawn ini again and the NPC is
-- blank exactly as he was before. A save made before the pack is repaired on load, because a blank NPC has no
-- active section to resume and the scheme is then chosen from scratch.
local function install_missing_schemes()
    local original_initialize = xr_logic.initialize_obj
    xr_logic.initialize_obj = function(object, storage, loaded, actor, stype, ...)
        local known, name = pcall(function() return object:name() end)
        local sections = known and missing_schemes[name] or nil
        if not sections then
            return original_initialize(object, storage, loaded, actor, stype, ...)
        end
        local ini = xr_logic.configure_schemes(object, read_only_ini(sections), "<customdata>", stype, "logic", nil)
        -- load_obj turns an empty saved section into the string "nil", which is not a section to resume.
        local resume = storage and storage.loaded_active_section
        if resume == "nil" then resume = nil end
        if loaded and resume then
            xr_logic.activate_by_section(object, ini, resume, true)
        else
            xr_logic.activate_by_section(object, ini,
                xr_logic.determine_section_to_activate(object, ini, "logic", actor), false)
        end
    end
end

local function install_lchanger_spots()
    local original_lchanger = level_tasks.add_lchanger_location
    level_tasks.add_lchanger_location = function(...)
        local result = original_lchanger(...)
        pcall(drop_parked_lchanger_spots)
        return result
    end
end

function install()
    if installed then return end
    installed = true
    pcall(install_yura_chain)
    pcall(install_rg6_cache)
    pcall(install_yantar_scientists)
    pcall(install_dead_city_exit)
    pcall(install_hellcar_group)
    pcall(install_community_gates)
    pcall(install_crate_stack)
    pcall(install_nemo_spawn)
    pcall(install_psy_ceiling)
    pcall(install_lchanger_spots)
    pcall(install_jammer_spot)
    pcall(install_missing_schemes)
    -- Two repairs need the actor's own binder: the Karabin quest re-checks its NPC on update, and the jammer
    -- map spot is retried until the object it points at exists. Both are per-level state.
    pcall(function()
        local binder = bind_stalker.actor_binder
        local original_spawn = binder.net_spawn
        binder.net_spawn = function(self, ...)
            jammer.wanted = false
            jammer.settled = false
            return original_spawn(self, ...)
        end
        local original_update = binder.update
        binder.update = function(self, ...)
            local result = original_update(self, ...)
            pcall(restore_nemo)
            pcall(settle_jammer_spot)
            return result
        end
    end)
end
