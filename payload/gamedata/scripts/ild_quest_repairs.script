-- The quest half of the repairs the forum audit turned up: jobs that could not start, could not finish, or
-- handed the player nothing. Nothing here touches an object the author removed from the spawn with
-- [spawner] cond = never - those scenes are his cuts, and the pack leaves them cut. Its sibling ild_mod_repairs.script carries the engine-level damage, and the two
-- are separate files only because the engine compiles a script with a fixed budget of module locals.
--
-- Every repair installs behind its own guard and is started through pcall, so a repair that cannot find what
-- it expects on a given save leaves the rest of the file working.
local installed = false

-- ---------- yura-stuck ----------
----------------------------------------------------------------------------------------------------------------------
-- Yura in the tunnel: a chain whose two waits have no way out
--
-- scripts\kordon\esc_qra2.ltx switches Yura through fourteen sections. Twelve of them end on a timer or on a
-- dialog the player can always open. Two end on nothing but the death of monsters:
--
--   [remark1]  waits for +esc_tonnel_psidog1_death and +esc_tonnel_psidog2_death, and the dialog that would
--              move him on (esc_qra2_posle_psisobak) asks for the same two portions, so a portion that never
--              arrives leaves him crouched in "hide" beside the dead dog with nothing to say.
--   [walker45] waits for all five +esc_kaban_tainika1_dead*, in def_state_standing = search and meet = no_meet,
--              so he searches the black digger's stash for the rest of the game and cannot even be talked to.
--              The author wrote the way out himself - [walker5], the same two paths, the digging state and a
--              25-second timer that plays the same line and hands out the same +esc_qra_dostal_xabar_tainika1 -
--              and then named it after a ';' at the end of walker45's on_info, which the ini reader drops as a
--              comment. Nothing in the file can reach [walker5].
--
-- The pack's generic repairs do not cover this. install_ai_watchdog only acts on a movement manager that is
-- walking and getting nowhere, on a wait the state manager armed and never began, and on a stalled team signal;
-- Yura in remark1 or walker45 has arrived, reached his animation and armed nothing, so the watchdog sees a
-- healthy NPC - and it refuses by construction to force a section that ends on a portion from elsewhere.
-- install_death_repairs delivers a death portion the callback lost, but only for a mob whose net_spawn it saw
-- while the portion was still missing; a corpse alife released before the player noticed, or a monster that
-- never came online at all, was never registered. Both holes are closed from the chain's own side below.
----------------------------------------------------------------------------------------------------------------------

local yura_installed = false
local yura_bridge

local function yura_report(text)
    -- Same console verb the pack's other watchdogs write through, and the same single probe for a build
    -- without the native bridge, where an unknown command would be logged as an error on every call.
    if yura_bridge == nil then
        local known, value = pcall(function() return get_console():get_string("ild_update") end)
        yura_bridge = known and value ~= nil
    end
    if not yura_bridge then return end
    pcall(function() get_console():execute("ild_update watchdog " .. text) end)
end

-- Each leg is open between the portion that spawns its monsters and the portion the chain sets once it is past
-- them. Outside that window nothing here does any work at all.
local yura_legs = {
    {
        opens = "esc_qra2_start_v_tonnele",
        closes = "esc_qra2_posle_psisobak",
        mobs = {
            {section = "esc_tonnel_psevdodog1", portion = "esc_tonnel_psidog1_death"},
            {section = "esc_tonnel_psevdodog2", portion = "esc_tonnel_psidog2_death"}
        }
    },
    {
        opens = "esc_qra_pered_tainikom1",
        closes = "esc_qra_dostal_xabar_tainika1",
        mobs = {
            {section = "esc_kaban_na_tainik11", portion = "esc_kaban_tainika1_dead1"},
            {section = "esc_kaban_na_tainik12", portion = "esc_kaban_tainika1_dead2"},
            {section = "esc_kaban_na_tainik13", portion = "esc_kaban_tainika1_dead3"},
            {section = "esc_kaban_na_tainik14", portion = "esc_kaban_tainika1_dead4"},
            {section = "esc_kaban_na_tainik15", portion = "esc_kaban_tainika1_dead5"}
        }
    }
}

local yura_check_period = 3000
local yura_scan_period = 10000
local yura_absent_grace = 90000
local yura_checked = 0
local yura_scanned = 0

-- One pass over the simulator resolves every monster of the leg that is still unknown. Offline objects are in
-- it too, so an id a completed pass cannot find is genuinely not in the world any more.
local function yura_resolve(leg, simulator, now)
    local pending = false
    for _, mob in ipairs(leg.mobs) do
        if not mob.id and not has_alife_info(mob.portion) then pending = true end
    end
    if not pending or now - yura_scanned < yura_scan_period then return end
    yura_scanned = now
    local wanted = {}
    for _, mob in ipairs(leg.mobs) do
        if not mob.id then wanted[mob.section] = mob end
    end
    for id = 1, 65534 do
        local server = simulator:object(id)
        local known, name = pcall(function() return server and server:section_name() end)
        local mob = known and name and wanted[name]
        if mob then mob.id = id end
    end
    leg.swept = now
end

local function yura_settle_leg(leg, now)
    if not has_alife_info(leg.opens) or has_alife_info(leg.closes) then return end
    local simulator = alife()
    if not simulator then return end
    leg.opened = leg.opened or now
    yura_resolve(leg, simulator, now)
    for _, mob in ipairs(leg.mobs) do
        if not has_alife_info(mob.portion) then
            local server = mob.id and simulator:object(mob.id)
            -- Ids are reused, so a remembered one is trusted only while it still names the same section.
            if server then
                local known, name = pcall(function() return server:section_name() end)
                if not known or name ~= mob.section then mob.id, server = nil, nil end
            end
            if server then
                local known, alive = pcall(function() return server:alive() end)
                if known and alive == false then
                    -- The section's own portion, handed out for the death its callback lost.
                    db.actor:give_info_portion(mob.portion)
                    yura_report("yura dead " .. mob.section)
                end
            elseif mob.id or (leg.swept and now - leg.opened > yura_absent_grace) then
                -- Either the corpse an earlier pass had found is gone, or a completed sweep cannot find the
                -- monster at all. Nothing is left for the player to kill, so nothing is being stepped over.
                mob.id = nil
                db.actor:give_info_portion(mob.portion)
                yura_report("yura gone " .. mob.section)
            end
        end
    end
end

local function yura_settle(now)
    if not db.actor or now - yura_checked < yura_check_period then return end
    yura_checked = now
    for _, leg in ipairs(yura_legs) do yura_settle_leg(leg, now) end
end

local yura_stall = {}
local yura_stall_period = 2000
local yura_stall_grace = 150000

-- The file is recognised by the section pair only esc_qra2.ltx has: walker45 on the stash path, and the
-- walker5 the same file writes and never reaches.
local function yura_stash_logic(storage)
    local ini = storage and storage.ini
    if not ini or not ini:section_exist("walker45") or not ini:section_exist("walker5") then return false end
    if not ini:line_exist("walker45", "path_walk") then return false end
    return ini:r_string("walker45", "path_walk") == "esc_qra_k_tainiky1_walk2"
end

local function yura_watch(npc)
    local id = npc:id()
    local storage = db.storage[id]
    if not storage or not storage.active_scheme or storage.active_section ~= "walker45" or not npc:alive() or
        not yura_stash_logic(storage) then
        yura_stall[id] = nil
        return
    end
    local now = time_global()
    local record = yura_stall[id]
    if not record then
        yura_stall[id] = {tm = now, waited = 0}
        return
    end
    if now - record.tm < yura_stall_period then return end
    local step = now - record.tm
    record.tm = now
    -- Only time the NPC actually spent updating is counted, so a gap - going offline, a load - never shortens
    -- the wait, and a player who walked away does not come back to a stash that opened itself.
    if step > yura_stall_period * 4 or npc:is_talking() then return end
    record.waited = record.waited + step
    if record.waited < yura_stall_grace then return end
    yura_stall[id] = nil
    -- The mod's own fallback section, entered the way the mod's own condlists enter one. walker5 then runs its
    -- 25-second timer, plays frazu\loot_bad_1, gives +esc_qra_dostal_xabar_tainika1 and goes to remark3 - the
    -- exact ending walker45 promises. Any boar still alive is left exactly where it is.
    xr_logic.switch_to_section(npc, storage[storage.active_scheme], "walker5")
    yura_report("yura stash " .. npc:name())
end

function install_yura_chain()
    if yura_installed then return end
    yura_installed = true
    local binder = xr_motivator.motivator_binder
    local original_update = binder.update
    binder.update = function(self, ...)
        local result = original_update(self, ...)
        -- A stall check must never be able to take the game down with it.
        pcall(yura_watch, self.object)
        return result
    end
    local actor = bind_stalker.actor_binder
    local original_actor_update = actor.update
    actor.update = function(self, ...)
        local result = original_actor_update(self, ...)
        pcall(yura_settle, time_global())
        return result
    end
end

-- Installed from install() below.

-- ---------- crate-stack ----------
-- The checkpoint quest hands the actor twenty 5 kg crates in ones and twos and takes them back one at a time.
-- Its closing hand-over, bar_ckpint.daq_iashik_nac_two, removes a fixed ten - bar_ckpint.script:127 calls
-- sak.out_item_namber("bar_iahik_nac", 10), and that helper stops at need_number. Seventeen crates are handed out
-- after the last return the quest forces (bar_iahik_nac_4 through bar_iahik_nac_1920 in dialogs_bar.xml), and the
-- only return in between, bar_iahik_nac_4_otdaq, is optional, so a player who carried the lot rather than walking
-- each one back keeps up to seven. The crate is quest_item = true at 5 kg and cost 0, and the same phrase's
-- bar_iahik_nac_1920_otdal shuts every dialog that could still take one: 35 kg that can never leave the rucksack.
local crates = {section = "bar_iahik_nac", done = "bar_iahik_nac_1920_otdal", count = 0,
    swept = 0, period = 5000, tries = 3, left = 3, installed = false}

local function count_crate(owner, item)
    if item and item.section and item:section() == crates.section then crates.count = crates.count + 1 end
end

local function crates_carried()
    crates.count = 0
    if not db.actor then return 0 end
    pcall(db.actor.iterate_inventory, db.actor, count_crate, db.actor)
    return crates.count
end

-- sak.out_item_namber removes at most need_number, so the number actually carried drains the stack and takes
-- nothing else. The mod's own news line comes with it, once, exactly as it does on the unrepaired hand-over.
local function drain_crates()
    local carried = crates_carried()
    if carried < 1 then return 0 end
    sak.out_item_namber(crates.section, carried)
    return carried
end

-- A save made before this repair still carries its orphans. Once the closing portion is set no dialog can take a
-- crate any more, so whatever is left is dead weight and goes on the next update. The budget is only there so a
-- stack that somehow refused to release could not spin a news line every five seconds; a rucksack with no crate
-- in it refills the budget, which is also how a later load gets its own tries.
local function sweep_crates(now)
    if not db.actor or now - crates.swept < crates.period then return end
    crates.swept = now
    if not has_alife_info(crates.done) then return end
    if not db.actor:object(crates.section) then crates.left = crates.tries return end
    if crates.left < 1 then return end
    crates.left = crates.left - 1
    drain_crates()
end

local function install_crate_stack()
    if crates.installed then return end
    if not bar_ckpint or not bind_stalker or not sak then return end
    if not bar_ckpint.daq_iashik_nac_two then return end
    crates.installed = true
    local original_hand_over = bar_ckpint.daq_iashik_nac_two
    bar_ckpint.daq_iashik_nac_two = function(first_speaker, second_speaker)
        -- An empty rucksack is the one case the mod already gets right; leave it to the original so the line it
        -- writes there stays exactly what it was.
        if drain_crates() > 0 then return end
        return original_hand_over(first_speaker, second_speaker)
    end
    local binder = bind_stalker.actor_binder
    local original_update = binder.update
    binder.update = function(self, ...)
        original_update(self, ...)
        pcall(sweep_crates, time_global())
    end
end

-- ---------- karabin-nemo ----------
-- 1.0.8 to 1.0.10 put "Nemo" (agro_nemo_tyt_vujivet) into the nationalist camp in place of the second extra
-- that the mod's own misnamed spawn_agro_nemo_tyt_vujivet creates. His section, profile, logic and escape path
-- all ship with the mod - and so does his immunity: fire, wounds and strikes do nothing to him, his remark
-- scheme cannot leave while he has an enemy, and an enemy he always has, the actor and Karabin both. So he
-- stood in the shoot-out for good, Karabin never left his own camper for the talk, and «Зацепка» could not be
-- closed. The repair is withdrawn: the mod's second mortal extra is back and its death hands out the third
-- portion the way it always did, and a save that already carries a Nemo loses him once, remembered in the
-- actor's pstor. Nothing refers to him by id, so nothing else changes.
local nemo_withdrawal = {section = "agro_nemo_tyt_vujivet", start = "agro_karabin_strt",
    flag = "ild_agro_nemo_withdrawn"}

local function withdraw_nemo()
    local actor = db.actor
    if not actor or not has_alife_info(nemo_withdrawal.start) then return end
    local known, done = pcall(xr_logic.pstor_retrieve, actor, nemo_withdrawal.flag, 0)
    if not known or (done or 0) ~= 0 then return end
    local simulator = alife()
    if not simulator then return end
    xr_logic.pstor_store(actor, nemo_withdrawal.flag, 1)
    local released = 0
    for id = 1, 65534 do
        local object = simulator:object(id)
        if object then
            local ok, name = pcall(object.section_name, object)
            if ok and name == nemo_withdrawal.section then
                simulator:release(object, true)
                released = released + 1
            end
        end
    end
    if released > 0 then log("ild: " .. nemo_withdrawal.section .. " withdrawn, " .. released .. " released") end
end

-- ---------- toymaker ----------
-- The Toymaker's peaceful branch - the eloquence line, phrases 662-669 of agro_igra_final - hands out only the
-- empty agro_ydivitilnui_cirk, and everything the aggressive branch leads to is shut for the rest of the game:
-- the poltergeist story's own end agro_polter_sdox, the door agr_dver_y_parashi that opens on it, and behind
-- it the tower key and cassette 2. The peaceful outcome counts as the story settled: the portion is granted,
-- the door opens by its own logic, and the task of the other branch was never given, so nothing else closes.
-- Not the fight's portion - that would start the fight and cancel the reward the skill bought.
--
-- The boiler-house killer as 1.0.8 and 1.0.9 left him. Those versions granted ara_tak_vtorogo_xyilu_ne_nado
-- the moment he raised his hands, and a player who shot him before the talk was done got neither the wounded
-- killer at the stairs nor the Toymaker. Such a save holds the portion and no agro_ybiica_start, a pair the
-- mod alone and 1.0.10 never produce. A living killer gets the portion taken back - the talk grants it again
-- and a shot gives the double - and a dead or absent one gets the double now, through the portion his own
-- [death] would have granted.
local toymaker = {peace = "agro_ydivitilnui_cirk", settled = "agro_polter_sdox",
    fight = {"agro_polter_spawn", "agro_spawn_polter_v_fabric", "agro_polter_sdox"}}
local killer = {section = "agro_kotelnui_ybiica", surrendered = "ara_tak_vtorogo_xyilu_ne_nado",
    talked = "agro_ybiica_start", shot = "aro_gg_v_glaz_popal", spawned = "agro_igryshechnik_start"}

local function any_of(names)
    for _, name in ipairs(names) do
        if has_alife_info(name) then return true end
    end
    return false
end

local function settle_toymaker()
    if not db.actor or not has_alife_info(toymaker.peace) or any_of(toymaker.fight) then return end
    db.actor:give_info_portion(toymaker.settled)
    log("ild: the Toymaker's peaceful branch settles the poltergeist story")
end

local function settle_killer()
    if killer.done or not db.actor then return end
    if not has_alife_info(killer.spawned) or not has_alife_info(killer.surrendered) or
        has_alife_info(killer.talked) or has_alife_info(killer.shot) or any_of(toymaker.fight) then return end
    local simulator = alife()
    if not simulator then return end
    killer.done = true
    local alive = false
    for id = 1, 65534 do
        local object = simulator:object(id)
        if object then
            local ok, name = pcall(object.section_name, object)
            if ok and name == killer.section then
                local known, living = pcall(object.alive, object)
                alive = known and living == true
                break
            end
        end
    end
    db.actor:disable_info_portion(killer.surrendered)
    if not alive then db.actor:give_info_portion(killer.shot) end
    log("ild: the boiler-house killer of a 1.0.8/1.0.9 save " .. (alive and "keeps his talk" or "gets his double"))
end

-- ---------- volk-tasks ----------
-- Two optional jobs of the Cordon's Volk, «ПРОПАЛИ!» and the duty with Tolik, are open entries with no end of
-- their own once the story leaves the Cordon: delete.delet_escape_volka removes him (story 6) when the player
-- moves on, and the two stay "in progress" for good. They are closed when he is removed, and once on a save
-- where that already happened - the portions that follow his removal say so more reliably than his absence.
-- The duty with Tolik that was served counts as completed; anything else fails, which fails its open steps.
local volk = {tasks = {"esc_poisk_novichkov_kvest", "tolik_i_volk_kvest"}, served = "esc_repka_konec_nax",
    gone = {"esc_sidor_cho_tyt", "brr_obersh_posli_stepu", "val_volk_poshli"}}

local function close_volk_tasks(reason)
    for _, id in ipairs(volk.tasks) do
        local known, state = pcall(function() return db.actor:get_task_state(id, 0) end)
        if known and state == task.in_progress then
            local outcome = (id == "tolik_i_volk_kvest" and has_alife_info(volk.served)) and task.completed or task.fail
            pcall(level_tasks.set_task_state, outcome, id, 0)
            log("ild: " .. id .. " closed, " .. reason)
        end
    end
end

local function install_volk_release()
    local original = delete and delete.delet_escape_volka
    if type(original) ~= "function" then return end
    delete.delet_escape_volka = function(...)
        local results = {original(...)}
        if db.actor then pcall(close_volk_tasks, "Volk released") end
        return unpack(results)
    end
end

local function settle_volk()
    if volk.done or not db.actor or not any_of(volk.gone) then return end
    volk.done = true
    close_volk_tasks("Volk long gone")
end

-- ---------- psy-antenna ----------
-- Installed from install() below.

-- The Radar antenna field is on the only road north, and carrying Sakharov's psy helmet makes it worse instead
-- of better. The mod lowered the bare-headed rows of two restrictors in all.spawn and left their helmet rows at
-- the vanilla numbers, which were written against a bare-headed hit of 100:
--   rad_antenna_rays_and_spot  no_helmet eff 10  hit 10   bad_helmet eff 100  hit 30   good_helmet eff 100  hit 20
--   rad_space_restrictor_0008  no_helmet eff +10 hit +10  bad_helmet eff +100 hit +20  good_helmet eff +100 hit +20
-- sr_psy_antenna scales both by 0.01, so a helmet in the belt buys a 0.20-0.30 wound hit every five seconds
-- against 0.10 bare-headed, under a psi postprocess ten times stronger. The author's bare-headed row is left
-- exactly as it stands and is read back from the object's own custom_data; nothing above it is let through.
local psy_ceiling_installed = false
local psy_ceiling_section = "sr_psy_antenna@no_helmet"
-- Read from all.spawn as it ships; used only if the object arrives configured from somewhere that has no such
-- section, so that a missing baseline still cannot raise the helmet above bare-headed.
local psy_ceiling_objects = {
    ["rad_antenna_rays_and_spot"] = {eff_intensity = 10, hit_intensity = 10},
    ["rad_space_restrictor_0008"] = {eff_intensity = 10, hit_intensity = 10}
}
local psy_ceiling_reported = {}

local function psy_ceiling_read(source, field)
    if not source then return nil end
    local known, value = pcall(function()
        if source:section_exist(psy_ceiling_section) and source:line_exist(psy_ceiling_section, field) then
            return source:r_float(psy_ceiling_section, field)
        end
    end)
    if known then return value end
end

local function psy_ceiling_value(ini, object, field, fallback)
    -- Both restrictors name no cfg file, so the ini the scheme was configured from is their own custom_data and
    -- already carries the bare-headed row; the spawn ini is only a second look for a re-pointed logic file.
    local value = psy_ceiling_read(ini, field)
    if value then return value end
    local known, spawn = pcall(function() return object:spawn_ini() end)
    value = known and psy_ceiling_read(spawn, field)
    if value then return value end
    return fallback
end

local function install_psy_ceiling()
    if psy_ceiling_installed then return end
    -- Naming the module here is what makes the engine load it; a build without it has nothing to wrap.
    if not sr_psy_antenna or type(sr_psy_antenna.set_scheme) ~= "function" then return end
    psy_ceiling_installed = true
    local original = sr_psy_antenna.set_scheme
    sr_psy_antenna.set_scheme = function(object, ini, scheme, section, gulag_name)
        local result = original(object, ini, scheme, section, gulag_name)
        local known, name = pcall(function() return object:name() end)
        local limits = known and name and psy_ceiling_objects[name]
        if not limits then return result end
        -- The scheme keeps one storage table per object and rewrites it on every section switch, so the ceiling
        -- belongs where the numbers are produced rather than where zone_enter adds them up. xr_logic calls this
        -- before it issues reset_scheme, so the clamped pair is what the zone is entered with.
        local storage = db.storage and db.storage[object:id()]
        local state = storage and storage[scheme]
        if not state then return result end
        local eff = psy_ceiling_value(ini, object, "eff_intensity", limits.eff_intensity) * 0.01
        local hit = psy_ceiling_value(ini, object, "hit_intensity", limits.hit_intensity) * 0.01
        local capped = false
        if state.intensity and state.intensity > eff then state.intensity, capped = eff, true end
        if state.hit_intensity and state.hit_intensity > hit then state.hit_intensity, capped = hit, true end
        -- The section switches on every entry and exit of the field, so one line per object is all it writes.
        if capped and not psy_ceiling_reported[name] then
            psy_ceiling_reported[name] = true
            pcall(log, "ild: " .. name .. " helmet psy values capped at its no-helmet row")
        end
        return result
    end
end

-- ---------- map-and-logic-gaps ----------
-- Four gaps between the mod's map, its spawn and its logic files. Every repair below puts the mod's own data
-- back where the mod's own code already looks for it; nothing is invented and no original file is touched.

-- The mod parks an object it wants gone by moving it kilometres off the level rather than deleting it.
local parked_depth = 2000
local lchanger_section = "level_changer"
local lchanger_spot = "level_changer"

-- Two all.spawn NPCs whose logic never arrives, keyed by the name all.spawn gives them. Each is held exactly
-- where the spawn put him, in the shape his own neighbours carry.
local missing_schemes = {
    -- bar_dolg_bunker_5 is assigned to the smart terrain bar_dolg_bunker. gulag_bar.ltx holds that gulag's job
    -- sections, but no smart_terrain object of that name is in all.spawn, so he joins nothing, carries no inline
    -- logic of his own and stands blank among the four posed guards. This is the logic his three remark
    -- neighbours - bar_dolg_bunker_1, _3 and _4 - carry in their own custom_data.
    bar_dolg_bunker_5 = {
        logic = {active = "remark", combat_ignore = "combat_ignore"},
        combat_ignore = {},
        remark = {
            anim = "patrol",
            meet = "no_meet",
            combat_ignore_cond = "{=fighting_dist_ge(10)} always"
        }
    }
}

local function parked_changer(server)
    local known, parked = pcall(function()
        return server:section_name() == lchanger_section and math.abs(server.position.y) >= parked_depth
    end)
    return known and parked
end

-- add_lchanger_location draws "to Yantar" on story object 608, exit_to_yantar_01, which the mod moved to
-- y = -15000.76 and replaced with the tunnel pair. The icon stays on the Rostok map and sends the player to a
-- transition that is not there. Every changer the mod parked the same way loses its icon; the live ones keep
-- theirs, and no other spot type is touched.
local function drop_parked_lchanger_spots()
    local simulator = alife()
    if not simulator then return end
    for id = 1, 65534 do
        local server = simulator:object(id)
        if server and parked_changer(server) then
            -- map_has_object_spot answers with a count, which is how level_tasks.remove_location_safe drains it.
            for _ = 1, level.map_has_object_spot(id, lchanger_spot) do
                level.map_remove_object_spot(id, lchanger_spot)
            end
        end
    end
end

-- Every map marker the mod places itself has one shape: a function that scans the simulation for an object by
-- section and calls level.map_add_object_spot on it. That call is not written into the save, so the marker is
-- gone after the next load, and a scan that runs before the object exists - the jammer is created eleven
-- actions after its marker is asked for - places nothing and says nothing. Both are what the thread reports as
-- "no marker on the map". The list of markers and the idea of a serialisable, retried spot are uroboross2's,
-- from his fix on the mod's forum; the shape is the pack's own. Each of the mod's marker functions becomes a
-- request, the request is honoured with map_add_object_spot_ser the moment its object exists, a marker that an
-- older version placed the volatile way is upgraded once, and every spot comes down on the portion that ends it.
local marker_rules = {
    {module = "new_life", fn = "metka_na_kopatela", section = "esc_dark_kopatel", spot = "blue_location",
        hint = "mtka_na_kopatelia", starts = {"esc_makarov_nygna_orygka"}},
    {module = "new_life", fn = "metka_na_tainik_s_antennoi", section = "esc_tainik_sidora_s_antennoi",
        spot = "crlc_big", hint = "esc_mtka_na_anteny", starts = {"esc_sidor_delo_po_dolgy"},
        stops = {"esc_teri_antenna_y_menia", "esc_radioantena_prizraka_zapyshena"}},
    {module = "new_life", fn = "metka_na_stanciq_prizraka", section = "esc_radiostancia_prizraka",
        spot = "crlc_big", hint = "esc_mtka_na_stanciq", starts = {"esc_sidor_delo_po_dolgy"},
        stops = {"esc_radioantena_prizraka_zapyshena"}},
    -- No portion ends this one; the box is spawned full, so the spot comes down once it has been emptied.
    {module = "new_life", fn = "metka_na_tainik_mamkinogo_shpiona", section = "esc_tainik_mamkinogo_shpiona",
        spot = "crlc_big", hint = "mtka_na_tainik_mamkinogo_shpiona", starts = {"esc_pervui_shpion_pacanchika_poshadil"},
        done = "ild_marker_spy_stash_done", empty_box = true},
    {module = "new_life", fn = "metka_na_space_dlia_btra_sda", name = "esc_dlia_btr_mai_space",
        spot = "blue_location", hint = "esc_dlia_btr_mai_space_txt", starts = {"esc_gg_zavel_btr"},
        stops = {"esc_makr_btr_privez"}},
    {module = "new_life", fn = "metka_na_mulo", section = "esc_kor_zona_dla_mula", spot = "blue_location",
        hint = "mtka_na_mulo", starts = {"es_kor_me_mulo"}, stops = {"es_kor_ydaliti_zony_dla_mulo"}},
    {module = "gar_scriptu", fn = "metochka_na_sikret_torga_irvisa", section = "gar_sikret_torgovec",
        spot = "crlc_big", hint = "metochka_na_sikret_torga_irvisa", starts = {"gar_spawn_sikret_torg"},
        stops = {"gar_delete_sikret_torg", "gar_sekret_torgash_ymer"}},
    {module = "moa_agro", fn = "metka_na_karaba_prosto", section = "agro_karabin", spot = "blue_location",
        hint = "mtka_na_karabina", starts = {"agr_o_now_dopelkvest_karab_pozval"},
        stops = {"agro_karabin_napizdel_choli"}},
    -- The mod asks for this one from two portions and never checks, and the first comes before the jammer
    -- exists. "mil_jora2_pred ydarom" is spelled with the space in the mod's own file.
    {module = "skladu", fn = "metka_na_glyshilky_mnlt", section = "mil_glyshilka_monolita",
        spot = "green_location", hint = "mtka_na_glyshky_mnlt",
        starts = {"mil_gg_nashel_v_drvn_rpg", "mil_jora2_pred ydarom"}, stops = {"mil_monolita_glyshilke_smerti"}},
    -- Two the mod places from its info handlers on a story object it never checks for.
    {story = 93, spot = "green_location", hint = "metka_dejyr_za_volka_text", starts = {"esc_post_pianka_tolik"},
        stops = {"ia_dejyrq_za_volka"}},
    {story = 5041, spot = "crlc_big", hint = "metka_gar_ot_qru_text", starts = {"gar_dopq_qra_posle_ximer_poshel_nax"}}
}
-- The handlers whose only work for these portions was the volatile spot the rules above now own.
local marker_handlers = {
    escape_tasks = {esc_post_pianka_tolik = 10, ia_dejyrq_za_volka = 10},
    garbage_tasks = {gar_dopq_qra_posle_ximer_poshel_nax = 11}
}
local markers = {next_tick = 0, cursor = 0, next_scan = 0, tick = 100, sweep = 2047, rest = 5000, last = 65534}

local function marker_reset()
    markers.next_tick, markers.cursor, markers.next_scan = 0, 0, 0
    for _, rule in ipairs(marker_rules) do rule.id, rule.bound, rule.requested = nil, nil, nil end
end

local function any_info(names)
    for _, name in ipairs(names or {}) do
        if has_alife_info(name) then return true end
    end
    return false
end

local function marker_matches(rule, server)
    if not server then return false end
    local known, hit = pcall(function()
        if rule.section then return server:section_name() == rule.section end
        return rule.name ~= nil and server:name() == rule.name
    end)
    return known and hit
end

local function marker_done(rule)
    if not rule.done then return false end
    local known, value = pcall(xr_logic.pstor_retrieve, db.actor, rule.done, 0)
    return known and value == 1
end

local function marker_reconcile(rule, server)
    local present = level.map_has_object_spot(server.id, rule.spot) ~= 0
    if rule.active and rule.empty_box then
        local known, emptied = pcall(function()
            local object = level.object_by_id(server.id)
            return object ~= nil and object:is_inv_box_empty() == true
        end)
        if known and emptied then
            xr_logic.pstor_store(db.actor, rule.done, 1)
            rule.active, rule.finished = false, true
        end
    end
    if rule.active then
        if rule.bound ~= server.id or not present then
            -- A spot an older version placed the volatile way is replaced by one the save keeps, once per load.
            if present then level.map_remove_object_spot(server.id, rule.spot) end
            level.map_add_object_spot_ser(server.id, rule.spot, rule.hint)
            rule.bound = server.id
        end
    elseif rule.finished then
        if present then level.map_remove_object_spot(server.id, rule.spot) end
        rule.bound = nil
    end
end

local function marker_update()
    if not db.actor then return end
    local simulator = alife()
    if not simulator then return end
    local now = time_global()
    if now < markers.next_tick then return end
    markers.next_tick = now + markers.tick
    local missing = false
    for _, rule in ipairs(marker_rules) do
        rule.finished = any_info(rule.stops) or marker_done(rule)
        rule.active = not rule.finished and (rule.requested or any_info(rule.starts))
        local server
        if rule.story then
            server = simulator:story_object(rule.story)
            rule.id = server and server.id
        elseif rule.id then
            server = simulator:object(rule.id)
            if not marker_matches(rule, server) then server, rule.id, rule.bound = nil, nil, nil end
        end
        if server then
            marker_reconcile(rule, server)
        elseif not rule.story and (rule.active or rule.finished) then
            missing = true
        end
    end
    if not missing or now < markers.next_scan then return end
    -- One shared sweep, a slice per tick: never a full pass over the simulation on a single frame.
    local last = math.min(markers.cursor + markers.sweep, markers.last)
    for id = markers.cursor, last do
        local server = simulator:object(id)
        if server then
            for _, rule in ipairs(marker_rules) do
                if not rule.story and not rule.id and (rule.active or rule.finished) and marker_matches(rule, server) then
                    rule.id = server.id
                    marker_reconcile(rule, server)
                end
            end
        end
    end
    markers.cursor = last + 1
    if markers.cursor > markers.last then markers.cursor, markers.next_scan = 0, now + markers.rest end
end

-- A fresh request starts a fresh sweep from the first id, so an object created in the same frame as the call -
-- which is how the mod's info portions do it - is found on the next tick rather than after the current pass.
local function marker_request(rule)
    rule.requested = true
    markers.next_tick, markers.cursor, markers.next_scan = 0, 0, 0
end

local function install_map_markers()
    for _, rule in ipairs(marker_rules) do
        -- A module or a function the installed mod does not have leaves that one rule to its start portions.
        local module = rule.module and _G[rule.module]
        if type(module) == "table" and type(module[rule.fn]) == "function" then
            module[rule.fn] = function() marker_request(rule) end
        end
    end
    for name, portions in pairs(marker_handlers) do
        local module = _G[name]
        if type(module) == "table" and type(module.process_info_portion) == "function" then
            local original = module.process_info_portion
            module.process_info_portion = function(info, ...)
                local index = portions[info]
                if index then
                    marker_request(marker_rules[index])
                    return
                end
                return original(info, ...)
            end
        end
    end
    local binder = bind_stalker.actor_binder
    local original_spawn, original_destroy, original_update = binder.net_spawn, binder.net_destroy, binder.update
    binder.net_spawn = function(self, ...)
        marker_reset()
        return original_spawn(self, ...)
    end
    binder.net_destroy = function(self, ...)
        marker_reset()
        return original_destroy(self, ...)
    end
    binder.update = function(self, ...)
        local result = original_update(self, ...)
        pcall(marker_update)
        return result
    end
end

-- The engine can build an ini only from a file, and this pack ships no file of its own into the mod's config
-- tree. It does not have to: every reader on the scheme path is Lua, and utils.cfg_get_string, cfg_get_bool and
-- cfg_get_number between them ask an ini for exactly section_exist, line_exist and one typed read. A table that
-- answers those is a complete stand-in for the section a missing file would have held.
local function read_only_ini(sections)
    local function value(section, line)
        local fields = sections[section]
        return fields and fields[line] or nil
    end
    local ini = {}
    function ini.section_exist(_, section) return sections[section] ~= nil end
    function ini.line_exist(_, section, line) return value(section, line) ~= nil end
    function ini.line_count(_, section)
        local count = 0
        for _ in pairs(sections[section] or {}) do count = count + 1 end
        return count
    end
    function ini.r_string(_, section, line) return value(section, line) end
    function ini.r_bool(_, section, line) return value(section, line) == "true" end
    function ini.r_float(_, section, line) return tonumber(value(section, line)) or 0 end
    function ini.r_u32(_, section, line) return tonumber(value(section, line)) or 0 end
    return ini
end

-- initialize_obj is the one place both NPCs pass through: neither belongs to a smart terrain - one says
-- none = true, the other names a terrain that is not in the spawn - so setup_gulag_and_logic_on_spawn sends
-- both here. The saved ini name stays the ordinary "<customdata>" the mod writes for every inline NPC, so a
-- save made with the pack still loads without it: the mod's own path reads the spawn ini again and the NPC is
-- blank exactly as he was before. A save made before the pack is repaired on load, because a blank NPC has no
-- active section to resume and the scheme is then chosen from scratch.
-- Yura in the tunnel starts his logic over from [walker] every time he comes back online: an NPC that goes
-- offline within a session is not "loaded", so xr_logic takes [logic] active again, and Yura walks off to the
-- tunnel from wherever the chain had brought him. The portions the chain leaves behind say where he was; the
-- latest stage they name is the section he resumes, activated the way the ordinary path activates one.
local yura_resume = {
    {"esc_qra_ia_nashel_xabar_t2", "walker7"}, {"esc_spawn_kycha_krovososov_na_qry", "walker66"},
    {"esc_qra_posle_tainika1", "walker6"}, {"esc_qra_dostal_xabar_tainika1", "remark3"},
    {"esc_qra_pered_tainikom1", "walker45"}, {"esc_qra2_posle_psisobak", "walker3"},
    {"esc_tonnel_psidog1_death esc_tonnel_psidog2_death", "remark2"}, {"esc_qra2_start_v_tonnele", "remark1"}
}

local function yura_resume_section()
    for _, entry in ipairs(yura_resume) do
        local all = true
        for portion in string.gmatch(entry[1], "%S+") do
            if not has_alife_info(portion) then all = false end
        end
        if all then return entry[2] end
    end
    return nil
end

local function resume_yura(object, stype)
    local known, section = pcall(function() return object:section() end)
    if not known or section ~= "esc_qra2" then return false end
    local resume = yura_resume_section()
    if not resume then return false end
    local ini = xr_logic.configure_schemes(object, object:spawn_ini(), "<customdata>", stype, "logic", nil)
    if not ini or not ini:section_exist(resume) then return false end
    xr_logic.activate_by_section(object, ini, resume, false)
    yura_report("resume " .. resume)
    return true
end

local function install_missing_schemes()
    local original_initialize = xr_logic.initialize_obj
    xr_logic.initialize_obj = function(object, storage, loaded, actor, stype, ...)
        local known, name = pcall(function() return object:name() end)
        local sections = known and missing_schemes[name] or nil
        if not sections then
            if not loaded then
                local resumed, done = pcall(resume_yura, object, stype)
                if resumed and done then return end
            end
            return original_initialize(object, storage, loaded, actor, stype, ...)
        end
        local ini = xr_logic.configure_schemes(object, read_only_ini(sections), "<customdata>", stype, "logic", nil)
        -- load_obj turns an empty saved section into the string "nil", which is not a section to resume.
        local resume = storage and storage.loaded_active_section
        if resume == "nil" then resume = nil end
        if loaded and resume then
            xr_logic.activate_by_section(object, ini, resume, true)
        else
            xr_logic.activate_by_section(object, ini,
                xr_logic.determine_section_to_activate(object, ini, "logic", actor), false)
        end
    end
end

local function install_lchanger_spots()
    local original_lchanger = level_tasks.add_lchanger_location
    level_tasks.add_lchanger_location = function(...)
        local result = original_lchanger(...)
        pcall(drop_parked_lchanger_spots)
        return result
    end
end

function install()
    if installed then return end
    installed = true
    pcall(install_yura_chain)
    pcall(install_crate_stack)
    pcall(install_psy_ceiling)
    pcall(install_lchanger_spots)
    pcall(install_map_markers)
    pcall(install_missing_schemes)
    pcall(install_volk_release)
    -- The settles that read the actor's portions run from the actor's own update.
    pcall(function()
        local binder = bind_stalker.actor_binder
        local original_spawn = binder.net_spawn
        binder.net_spawn = function(self, ...)
            killer.done, volk.done = nil, nil
            return original_spawn(self, ...)
        end
        local original_update = binder.update
        binder.update = function(self, ...)
            local result = original_update(self, ...)
            pcall(withdraw_nemo)
            pcall(settle_toymaker)
            pcall(settle_killer)
            pcall(settle_volk)
            return result
        end
    end)
end
