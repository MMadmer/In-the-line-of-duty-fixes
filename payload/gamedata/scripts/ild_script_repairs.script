local installed = false
local actor_repairs_installed = false
local detector_started = false
local artefacts_dirty = false
local detector_spots = true
local overlay

local giant_sections = {
    ["mob_walker@1"] = true,
    ["mob_walker@2"] = true,
    ["mob_walker@3"] = true,
    ["mob_walker@4"] = true
}
local giant_bad_transition = "{=actor_in_zone(x18_dlia_sevducha_gg_tyt5)} %=bar_arena_hit% mob_walker@6"

local knife_sections = {
    wpn_knife = "fake_wpn_knife",
    wpn_knife_6x4 = "fake_wpn_knife_6x4",
    wpn_knife_6x2 = "fake_wpn_knife_6x2",
    lom = "fake_lom",
    wpn_knife_nkvd = "fake_wpn_knife_nkvd"
}

local detector_sections = {
    af_medusa = true,
    af_cristall_flower = true,
    af_vyvert = true,
    af_gravi = true,
    af_blood = true,
    af_mincer_meat = true,
    af_electra_sparkler = true,
    af_electra_flash = true,
    af_rusty_thorn = true,
    af_rusty_kristall = true,
    af_ameba_slime = true,
    af_ameba_slug = true,
    af_drops = true,
    af_fireball = true,
    af_dummy_battery = true,
    af_dummy_dummy = true,
    af_dummy_spring = true
}

local function reconcile_artefacts()
    local simulator = alife()
    if not simulator then return end
    for id = 1, 65534 do
        local object = simulator:object(id)
        if object and detector_sections[object:section_name()] and not db.artefacts[id] then
            db.artefacts[id] = {spot = false, tim_beep = 0}
        end
    end
    return true
end

local function install_zone_update(zone_class, native_class)
    zone_class.update = function(self)
        native_class.update(self)
        if not self.last_spawn_time then self.last_spawn_time = game.get_game_time() end
        if game.get_game_time():diffSec(self.last_spawn_time) >= self.artefact_spawn_idle then
            self.last_spawn_time = game.get_game_time()
            if math.random(100) <= self.artefact_spawn_rnd then
                -- The native method returns void and can create several server objects.
                self:spawn_artefacts()
                artefacts_dirty = true
            end
        end
    end
end

local function install_monster_death()
    local binder = bind_monster.generic_object_binder
    local original = binder.death_callback
    binder.death_callback = function(self, victim, who)
        if who and db.actor then return original(self, victim, who) end
        -- Environmental deaths have no killer; retain the original event arguments.
        if self.st.mob_death then
            xr_logic.issue_event(self.object, self.st.mob_death, "death_callback", victim, who)
        end
        if self.st.active_section then
            xr_logic.issue_event(self.object, self.st[self.st.active_scheme], "death_callback", victim, who)
        end
        smart_terrain.on_death(self.object:id())
        if db.actor then
            local impulse = hit()
            impulse.draftsman = self.object
            impulse.type = hit.fire_wound
            impulse.direction = db.actor:position():sub(self.object:position())
            impulse:bone("pelvis")
            impulse.power = 1
            impulse.impulse = 10
            self.object:hit(impulse)
        end
    end
end

local function install_hidden_slots()
    local window = hidden_slots.BkgrWnd
    local original_init = window.InitControls
    local original_init_btn = hidden_slots.init_btn
    local current
    -- InitControls assigns self.btn right before init_btn(k); the knife button is not stored anywhere else.
    hidden_slots.init_btn = function(number, section)
        if number == 1 and current then current.ild_knife_button = current.btn end
        return original_init_btn(number, section)
    end
    -- Only Lua-defined methods may be taken from a luabind class object. Inherited C++ methods such as
    -- AddCallback have no default implementation there and raise "pure virtual function called".
    window.InitControls = function(self)
        -- __init fills ClickBtn before InitControls; the loop registers whatever ClickBtn[1] holds now.
        self.ClickBtn[1] = function()
            local actor, simulator = db.actor, alife()
            local item = actor and actor:item_in_slot(0)
            local section = item and knife_sections[item:section()]
            if not section or not simulator or not simulator:object(item:id()) then return end
            hidden_slots.spawn_item_in_inv(section)
            hidden_slots.remove_item(item:id())
            if self.ild_knife_button then self.ild_knife_button:Show(false) end
        end
        current = self
        local result = original_init(self)
        current = nil
        overlay = self
        return result
    end
    local original_on_info = hidden_slots.on_info
    hidden_slots.on_info = function(info_id)
        local owner = info_id == "ui_inventory" and overlay and level.main_input_receiver()
        if not owner then return original_on_info(info_id) end
        -- The mod rebuilds the overlay (two statics, three buttons, callbacks) on every open and never
        -- detaches the old copies; the first window serves the inventory for the rest of the level.
        overlay.owner = owner
        owner:AttachChild(overlay.stat)
        for index = 1, 3 do hidden_slots.init_btn(index) end
        overlay.stat:Show(true)
    end
    hidden_slots.inventory_close = function()
        -- The original keeps the receiver captured at overlay creation; the live one survives level changes.
        local window = level.main_input_receiver()
        if window and window:IsShown() then level.start_stop_menu(window, true) end
    end
end

local function install_actor_repairs()
    if actor_repairs_installed then return end
    main_sleep.eat_food = function()
        local actor = db.actor
        if not actor then return end
        for _, section in ipairs({"conserva", "bread", "kolbasa"}) do
            local item = actor:object(section)
            if item then
                actor:eat(item)
                return
            end
        end
    end
    amk.remove_items = function(section, count)
        local actor, simulator = db.actor, alife()
        if not actor or not simulator then return end
        count = count or 1
        for index = actor:object_count() - 1, 0, -1 do
            if count <= 0 then break end
            local item = actor:object(index)
            if item and item:section() == section then
                local server_object = simulator:object(item:id())
                if server_object then
                    simulator:release(server_object, true)
                    count = count - 1
                end
            end
        end
    end
    install_hidden_slots()
    ild_recipe_repairs.install()

    local detector = bind_det_arts
    local original_start = detector.start_update
    detector.start_update = function()
        if not db.actor then return end
        original_start()
        detector_started = true
    end
    detector.update = function()
        local actor = db.actor
        if not actor then return true end
        local item = actor:item_in_slot(1)
        local section = item and item:section()
        if section == "det_artefact_indy" then detector.det_indy()
        elseif section == "det_artefact_pro" then
            detector_spots = true
            detector.det_normal()
        elseif section == "det_artefact_super" then
            detector_spots = true
            detector.det_super()
        elseif detector_spots then
            -- Spots exist only after a detector ran; one sweep when it is put away replaces a per-frame scan.
            detector.iteration_del_spot()
            detector_spots = false
        end
        -- A true fastcall result removes the callback from the physics commander.
        return false
    end
    actor_repairs_installed = true
end

-- The Cordon mechanic's Fort upgrades all call give_fort, which unconditionally destroys a plain wpn_fort.
-- The reward that follows in the same phrase is what identifies the pistol actually being handed in.
local fort_sources = {
    esc_l_d_mex_nam_fort_m1 = "wpn_fort",
    esc_l_d_mex_nam_fort_m2 = "wpn_fort",
    esc_l_d_mex_nam_fort_m3 = "wpn_fort",
    esc_l_d_mex_dengi_za_fort = "wpn_fort",
    esc_l_d_mex_nam_fort_m12 = "wpn_fort_mod1",
    esc_l_d_mex_nam_fort_m22 = "wpn_fort_mod2"
}

local function install_dialog_repairs()
    -- The reward was cloned from b_mne_mod_ekz15 and kept its section, so outfit_exo_mod58 never existed.
    pochinka.b_mne_mod_ekz58 = function(first_speaker, second_speaker)
        dialogs.relocate_item_section(second_speaker, "outfit_exo_mod58", "in")
    end
    -- Sakharov's reward names a texture path instead of an item section; alife():create fatals on it.
    dialogs_yantar.give_ecolog_outfit = function(first_speaker, second_speaker)
        if has_alife_info("yan_ecolog_outfit_given") then return end
        dialogs.relocate_item_section(second_speaker, "ecolog_outfit", "in")
        db.actor:give_info_portion("yan_ecolog_outfit_given")
    end

    local pending_fort = false
    pochinka.give_fort = function() pending_fort = true end
    for name, section in pairs(fort_sources) do
        local original_reward = pochinka[name]
        if original_reward then
            pochinka[name] = function(first_speaker, second_speaker)
                if pending_fort then
                    pending_fort = false
                    if sak.have_item_namber(section, 1) then sak.out_item_namber(section, 1) end
                end
                return original_reward(first_speaker, second_speaker)
            end
        end
    end
end

local function logic_config(object)
    local ini = object and object:spawn_ini()
    if not ini or not ini:section_exist("logic") or not ini:line_exist("logic", "cfg") then return nil end
    return string.lower(ini:r_string("logic", "cfg"))
end

-- The mod seals some of its treasure boxes with its own "never" idiom: on_use waits for an info portion that
-- exists only to kill the player, so nobody can ever hold it. Sidorovich sells one of those boxes, and a direct
-- grant fills it and marks it on the map, but the box keeps asking for a key that does not exist. Once its
-- treasure has been granted, a sealed box gets what the vanilla treasure box has: the native search.
local sealed_box_config = [[scripts\tainiki\esc_orig_tainik_zakrut.ltx]]
local search_tip = "st_search_treasure"

local function treasure_granted(story_id)
    if not story_id or story_id < 0 then return false end
    local manager = treasure_manager.get_treasure_manager()
    local key = manager.treasure_by_target and manager.treasure_by_target[story_id]
    local entry = key and manager.treasure_info[key]
    return entry ~= nil and entry.done == true
end

local function unseal_box(object, state)
    state.nonscript_usable = true
    state.tips = search_tip
    object:set_nonscript_usable(true)
    object:set_tip_text(search_tip)
end

-- A box that is already online was sealed when its scheme started; open it now rather than on the next load.
local function unseal_online_box(story_id)
    local server = alife():story_object(story_id)
    local object = server and level.object_by_id(server.id)
    local storage = object and db.storage[object:id()]
    local state = storage and storage.ph_idle
    if state and logic_config(object) == sealed_box_config then unseal_box(object, state) end
end

local function install_stash_repairs()
    local original_scheme = ph_idle.set_scheme
    ph_idle.set_scheme = function(npc, ini, scheme, section, gulag_name)
        local result = original_scheme(npc, ini, scheme, section, gulag_name)
        if logic_config(npc) == sealed_box_config then
            local server = alife():object(npc:id())
            local storage = db.storage[npc:id()]
            local state = storage and storage[scheme]
            if server and state and treasure_granted(server.m_story_id) then unseal_box(npc, state) end
        end
        return result
    end
end

local function install_world_repairs()
    -- Fvector is exported with a default constructor only; vector(99) raises before the item is spawned,
    -- which aborts the remaining nineteen decoration actions of the Agroprom-underground info portion.
    decor.spawn_und_tv = function()
        amk.spawn_item("televizor", vector():set(-46.8, -15.5, -43.6), 741, 4350)
    end

    -- The campfire light at Sidorovich's bunker was given the level/game vertex pair of the digger tunnels,
    -- 619 m away, so alife never switched it online where it belongs. Resolve the vertices from the position.
    decor.spawn_esc_svet_y_sidora = function()
        local position = vector():set(-242, -20.8, -135)
        local actor = db.actor
        if not actor then return end
        alife():create("svet_kostra", position, level.vertex_id(position), actor:game_vertex_id())
    end

    -- Direct dialog grants bypass CTreasure:use, whose done flag is the only guard against a second spawn.
    local original_give = treasure_manager.CTreasure.give_treasure
    treasure_manager.CTreasure.give_treasure = function(self, key)
        local entry = self.treasure_info[key]
        if not entry or entry.done then return end
        local result = original_give(self, key)
        if entry.done then unseal_online_box(entry.target) end
        return result
    end

    -- "target" is read with utils.cfg_get_number under a string default, so a section without it yields ""
    -- and alife():story_object("") raises a luabind type error that kills the monster's scheme. A literal
    -- "actor" degrades to story id 0 through atof, so the scripted mob never turns to face the player.
    local original_set = mob_remark.set_scheme
    mob_remark.set_scheme = function(npc, ini, scheme, section, gulag_name)
        local result = original_set(npc, ini, scheme, section, gulag_name)
        local storage = db.storage[npc:id()]
        local state = storage and storage[scheme]
        if state then
            local raw = ini:section_exist(section) and ini:line_exist(section, "target") and
                ini:r_string(section, "target") or nil
            state.ild_look_actor = raw == "actor"
            state.look = tonumber(raw)
        end
        return result
    end
    local original_reset = mob_remark.mob_remark.reset_scheme
    mob_remark.mob_remark.reset_scheme = function(self)
        local result = original_reset(self)
        if self.st.ild_look_actor and db.actor then
            action(self.object, look(look.point, db.actor:position()), cond(cond.look_end))
        end
        return result
    end
end

-- Sound files the mod's scripts ask for but that ship in neither the loose tree nor the archives. Constructing a
-- sound_object for a missing file is an engine fatal, not a recoverable error, so these must never reach it.
local absent_sounds = {
    [ [[music\trava_y_doma_obrez]] ] = true,
    [ [[new\ost_mgnovenia_17]] ] = true,
    [ [[weapons\pm\pm_shoot]] ] = true
}
local absent_sound_prefix = [[soundtrack\]]
local silent_sound

-- The Cordon gold-fish stash asks for device\pda_news; the file is device\pda\pda_news, which is how every
-- other caller in the mod spells it. A sound_object built on a name that exists nowhere is an engine fatal,
-- so the stash killed the game the moment it was opened.
local sound_aliases = {[ [[device\pda_news]] ] = [[device\pda\pda_news]]}

local function make_silent_sound()
    local function ignore() end
    return {
        play = ignore, play_at_pos = ignore, play_no_feedback = ignore, stop = ignore, stop_deffered = ignore,
        set_position = ignore, set_frequency = ignore, set_volume = ignore, attach_tail = ignore,
        playing = function() return false end, length = function() return 0 end
    }
end

local function sound_is_absent(path)
    if type(path) ~= "string" then return false end
    local name = string.lower(path)
    return absent_sounds[name] == true or
        string.sub(name, 1, string.len(absent_sound_prefix)) == absent_sound_prefix
end

local function install_sound_repairs()
    silent_sound = silent_sound or make_silent_sound()
    local original_get = xr_sound.get_safe_sound_object
    xr_sound.get_safe_sound_object = function(path)
        local named = type(path) == "string" and sound_aliases[string.lower(path)] or path
        -- The mod's own call sites test the result, but the fatal happens inside the constructor, before the
        -- test. A silent stub keeps every caller working, guarded or not.
        if sound_is_absent(named) then return silent_sound end
        return original_get(named)
    end
end

local function install_npc_repairs()
    -- Gulag jobs resolve their paths relative to the smart terrain, so this absolute path became
    -- esc_blokpost_esc_voen_sniper_spati, which does not exist, and patrol() aborted the game.
    if xr_sleeper and xr_sleeper.set_scheme then
        local original_sleeper = xr_sleeper.set_scheme
        xr_sleeper.set_scheme = function(npc, ini, scheme, section, gulag_name)
            local result = original_sleeper(npc, ini, scheme, section, gulag_name)
            local storage = db.storage[npc:id()]
            local state = storage and storage[scheme]
            if state and state.path_main == "esc_blokpost_esc_voen_sniper_spati" then
                state.path_main = "esc_voen_sniper_spati"
            end
            return result
        end
    end

    -- death_manager keys its drop tables by a hard-coded community whitelist that the mod's own factions are
    -- missing from, so pairs(nil) aborted the death callback before it could unbind the engine callbacks.
    local original_release = death_manager.drop_manager.create_release_item
    death_manager.drop_manager.create_release_item = function(self, ...)
        local completed, result = pcall(original_release, self, ...)
        if completed then return result end
        return nil
    end
end

local function install_hud_repairs()
    -- m_endTime is compared against a seconds clock, so the divisor must be exactly 1000. The neighbouring
    -- banners in the same file already use 1000, which is what makes these five a typo rather than a design.
    local banners = {
        stalkerok_navuk_lvl1 = {"chibi_rechi_navuk_lvl1", 20},
        chibi_dost_za_vse_kassetu = {"chibi_dost_za_vse_kassetu", 15},
        stalkerok_mexanik_navuk_lvl1 = {"chibi_mex_navuk_lvl1", 20},
        stalkerok_mexanik_navuk_lvl2 = {"chibi_mex_navuk_lvl2", 20},
        stalkerok_navuk_poisk_lvl1 = {"chibi_poisk_navuk_lvl1", 20}
    }
    for name, banner in pairs(banners) do
        if new_life[name] then
            local static_name, seconds = banner[1], banner[2]
            new_life[name] = function()
                local hud = get_hud()
                local static = hud:GetCustomStatic(static_name) or hud:AddCustomStatic(static_name, true)
                static.m_endTime = time_global() / 1000 + seconds
            end
        end
    end
    amk.chibi_pereves = function()
        local hud = get_hud()
        local static = hud:GetCustomStatic("chibi_pereves") or hud:AddCustomStatic("chibi_pereves", true)
        static.m_endTime = time_global() / 1000 + 10
    end
end

local workbench_slots = {rep_s1 = 1, rep_s2 = 2, rep_s6 = 6}

local function clamp_workbench(window_class, floor)
    if not window_class then return end
    for name, slot in pairs(workbench_slots) do
        local original_repair = window_class[name]
        if original_repair then
            window_class[name] = function(self, ...)
                local item = db.actor and db.actor:item_in_slot(slot)
                local before = item and item:condition()
                local result = original_repair(self, ...)
                -- A bench guarantees its tier as a floor. It never re-grinds a better item down to that tier,
                -- and the level-2 bench's slot-6 handler must not leave the outfit at its 0.01 typo.
                if item and before then item:set_condition(math.max(before, floor)) end
                return result
            end
        end
    end
end

local function install_workbench_repairs()
    clamp_workbench(stanok.baliaaa, 0.75)
    clamp_workbench(stanok.pochinka2, 0.85)
end

-- The engine never uses a shovel up. Four grave stashes take it through this one effect instead: always on the
-- Garbage and Agroprom graves, and on a roll on Cordon's two, which is why some shovels seemed to last and others
-- did not. Digging keeps everything else it costs and gives - stamina, sounds, the loot, the grave closing for good.
local function install_shovel_repairs()
    if type(xr_effects.minys_lopata) == "function" then xr_effects.minys_lopata = function() end end
end

-- Stock ph_car parks a car for good once the position scripts can see has not moved for a second. The engine
-- refreshes that position for an unarmed car only while it is seen or near the camera, so the rally trucks were
-- stopped as soon as the player stopped watching them. The loader keeps cars updating where it can patch the
-- engine; everywhere else a car the physics shows moving, or one still changing gear after its start, is simply
-- not judged stuck. A car that really cannot move is still parked by the scheme's own check.
local function install_car_repairs()
    local car = ph_car and ph_car.action_car
    if not car or type(car.start_car) ~= "function" or type(car.fast_update) ~= "function" then return end
    local original_start, original_update = car.start_car, car.fast_update
    car.start_car = function(self, ...)
        self.ild_started = time_global()
        return original_start(self, ...)
    end
    car.fast_update = function(self, ...)
        local now = time_global()
        local moving = self.ild_started ~= nil and now - self.ild_started < 5000
        if not moving then
            local known, speed = pcall(function() return self.car:CurrentVel():magnitude() end)
            moving = known and speed >= (self.min_delta_per_sec or 0.2)
        end
        if moving then self.last_pos, self.last_pos_time = nil, now end
        return original_update(self, ...)
    end
end

local function install_text_repairs()
    -- The mod replaced string_table_tips_escape.xml with its own file and lost this vanilla id; the engine
    -- returns the id itself when a string is absent, which is what reached the player's PDA.
    local original_direction_fire = xr_effects.esc_direction_fire
    xr_effects.esc_direction_fire = function(actor, npc)
        if game.translate_string("esc_direction_fire") == "esc_direction_fire" then return end
        return original_direction_fire(actor, npc)
    end
end

-- A world sound source counts as radio or music when its own theme plays files from a music, radio or
-- soundtrack path. Reading the theme table at runtime covers every source the mod has, including any the
-- name list below would have missed; the names are kept for themes whose paths do not say what they are.
local radio_names = {
    bar_radio_letagina = true, esc_wolf_radio = true, esc_wolf_radio_1 = true,
    radio_gar_stalker_torgovec = true, radio_sikret1 = true, radio_sikret2 = true, radio_sikret3 = true,
    radio_sikret4 = true, radio_sikret1488 = true, kasset_music = true
}
local radio_markers = {"music", "radio", "muz", "myz", "soundtrack", "pesn", "trek"}
local radio_cache = {}
local radio_factor = 0.70
local radio_checked = 0

-- The support verbs live in the native console bridge, and an installation can be without it. A command the
-- console does not know is logged as an error on every call, while get_string answers nil for it, so the bridge
-- is looked up once and every verb is skipped when it is absent.
local bridge_present

local function bridge_ready()
    if bridge_present == nil then
        local known, value = pcall(function() return get_console():get_string("ild_update") end)
        bridge_present = known and value ~= nil
    end
    return bridge_present
end

local function is_radio_theme(theme)
    if type(theme) ~= "string" then return false end
    local cached = radio_cache[theme]
    if cached ~= nil then return cached end
    local result = radio_names[theme] == true
    local themes = sound_theme and sound_theme.ph_snd_themes
    local files = themes and themes[theme]
    if not result and type(files) == "table" then
        for _, path in pairs(files) do
            local lower = string.lower(tostring(path))
            for _, marker in ipairs(radio_markers) do
                if string.find(lower, marker, 1, true) then
                    result = true
                    break
                end
            end
            if result then break end
        end
    end
    radio_cache[theme] = result
    return result
end

local function refresh_radio_volume()
    local now = time_global()
    if now - radio_checked < 1000 then return end
    radio_checked = now
    if not bridge_ready() then return end
    local console = get_console()
    console:execute("ild_update read setting_radio_volume")
    local percent = tonumber(console:get_string("ild_update"))
    radio_factor = percent and percent / 100 or 0.70
end

local function install_radio_volume()
    local original_update = ph_sound.snd_source.update
    ph_sound.snd_source.update = function(self, delta)
        local result = original_update(self, delta)
        local sound = self.played_sound
        if sound and self.st and is_radio_theme(self.st.theme) then
            refresh_radio_volume()
            -- Guarded: if this build will not take a volume, the scheme must still run normally.
            pcall(function() sound.volume = radio_factor end)
            -- Zero has to be silent even if the property above did nothing at all.
            if radio_factor <= 0 then pcall(function() sound:stop() end) end
        end
        return result
    end
end

local function reset_detector_registry()
    for id, entry in pairs(db.artefacts) do
        if entry.spot then level.map_remove_object_spot(id, "artefact_location") end
    end
    db.artefacts = {}
    detector_started = false
    detector_spots = true
end

local function restore_input_timeout(binder)
    local storage = binder.st
    if storage and storage.disable_input_time and not storage.disable_input_idle then
        -- The existing save stores the timestamp, not actor_punch's fixed 30-second duration.
        storage.disable_input_idle = 30
    end
end

-- Scripted NPC behaviour runs entirely on engine callbacks: move_mgr leaves its walking state only through
-- waypoint_callback, and the state manager arms the wait that ends a section only once the requested
-- animation has actually been reached. Neither has a timeout, so a path the engine cannot build, or an
-- animation it never reaches, leaves the NPC standing for good and the quest with it - which is exactly why
-- reloading a save clears it. Each recovery below re-runs only what the game itself would have run, so no
-- scripted step is ever skipped.
local watch = {}
local watch_period = 2000
local move_grace = 20000
local wait_grace = 30000
local sync_grace = 60000
local rescue_reach = 2
local move_epsilon = 0.5

local function report_line(text)
    -- Rare by construction, and the only trace an intervention leaves. The console verb writes it beside
    -- the loader report; a build without the native bridge simply has nowhere to write it.
    if not bridge_ready() then return end
    pcall(function() get_console():execute("ild_update watchdog " .. text) end)
end

local function watch_report(npc, section, action)
    report_line(action .. " " .. npc:name() .. " " .. section)
end

-- A story object that is gone is not a configuration error. The mod's two Garbage deserters arrive on Cordon
-- and are meant to walk into the restrictor that removes them, and the player may shoot them instead; either
-- way the object the restrictor names by story id stops existing. cfg_get_npc_and_zone aborted on that
-- instead of on a real mistake, so every later arrival on Cordon was fatal. An object that does not exist can
-- never be inside a zone, so the condition is kept and simply never fires - exactly what the section does
-- while the object is merely somewhere else. The "not in zone" form is neutralised the same way rather than
-- firing on an object nobody can find. 65535 is the engine's own "no object" id, so the lookup that follows
-- returns nothing without ever seeing a bad argument.
local absent_object_id = 65535

local function install_story_object_repair()
    local original = xr_logic.cfg_get_npc_and_zone
    xr_logic.cfg_get_npc_and_zone = function(ini, section, field, npc)
        local simulator = alife()
        local condition = simulator and xr_logic.cfg_get_two_strings_and_condlist(ini, section, field, npc)
        if not condition or simulator:story_object(tonumber(condition.v1)) then
            return original(ini, section, field, npc)
        end
        condition.npc_id = absent_object_id
        condition.name = string.gsub(condition.name, "^on_npc_not_in_zone", "on_npc_in_zone")
        report_line("story " .. npc:name() .. " " .. section .. " " .. field .. " " .. tostring(condition.v1))
        return condition
    end
end

-- on_death indexes both the dying object and its smart terrain without a check, while unregister_npc right
-- below it guards the second one. A death callback that runs after the server object is already released -
-- which the mod does by script all over the place - raised inside the callback instead.
local function install_smart_terrain_repair()
    local original = smart_terrain.on_death
    smart_terrain.on_death = function(object_id)
        local simulator = alife()
        local server = simulator and simulator:object(object_id)
        if not server then return end
        if server:smart_terrain_id() ~= absent_object_id then
            local owner = simulator:object(server:smart_terrain_id())
            if not owner or not owner.gulag then return end
        end
        return original(object_id)
    end
end

local function watch_distance(record, position)
    local dx, dy, dz = position.x - record.x, position.y - record.y, position.z - record.z
    return dx * dx + dy * dy + dz * dz
end

local function watch_mark(record, npc, now)
    local position = npc:position()
    record.x, record.y, record.z = position.x, position.y, position.z
    record.moved, record.tries = now, 0
end

local function watch_reset(mgr)
    mgr:reset(mgr.path_walk, mgr.path_walk_info, mgr.path_look, mgr.path_look_info, mgr.team,
        mgr.suggested_state, mgr.move_cb_info, mgr.no_validation)
end

-- Two rebuilds mean the route itself cannot be walked. This engine has no way to place a client NPC
-- anywhere, so the way out is its other movement mode: a free level path to the point the NPC was walking
-- to, planned from scratch and not bound to the patrol's own edges. The point is the next one rather than
-- the end of the path, and it is a valid AI node by construction, so nothing scripted is stepped over.
local function watch_rescue(npc, mgr)
    if not mgr.patrol_walk then return nil end
    local count = mgr.patrol_walk:count()
    local index = npc:get_current_point_index()
    if not index or index < 0 or index >= count then
        index = mgr.last_index and mgr.last_index + 1 or 0
    end
    if index >= count then index = count - 1 end
    -- An animation the NPC cannot leave is one of the two ways it gets stuck here, and standing it up is
    -- what the engine's own go-to-waypoint helper does before handing it a level path.
    if npc:animation_count() > 0 then npc:clear_animations() end
    npc:set_body_state(move.standing)
    npc:set_path_type(game_object.level_path)
    npc:set_detail_path_type(move.dodge)
    npc:set_movement_type(move.walk)
    npc:set_dest_level_vertex_id(mgr.patrol_walk:level_vertex_id(index))
    return index
end

-- Standing still is normal in combat, under fire, while wounded, and while the player is being met.
local function watch_busy(npc, storage)
    if npc:best_enemy() or npc:best_danger() or npc:is_talking() then return true end
    if xr_wounded and xr_wounded.is_wounded and xr_wounded.is_wounded(npc) then return true end
    local meet = storage.meet
    return meet ~= nil and meet.meet_manager ~= nil and tostring(meet.meet_manager.state) ~= "nil"
end

local function watch_npc(npc)
    local id = npc:id()
    local storage = db.storage[id]
    if not storage or not storage.active_scheme or not npc:alive() then
        watch[id] = nil
        return
    end
    local now = time_global()
    local state = storage[storage.active_scheme]
    local section = state and state.section or storage.active_scheme
    local record = watch[id]
    if not record then
        record = {tm = now, section = section}
        watch_mark(record, npc, now)
        watch[id] = record
        return
    end
    if now - record.tm < watch_period then return end
    record.tm = now

    -- A new section is a new wait, so nothing carries over from the one before it.
    if record.section ~= section or watch_busy(npc, storage) then
        record.section, record.armed, record.synced = section, nil, nil
        watch_mark(record, npc, now)
        return
    end

    -- The movement manager is only ours to touch while it is running the active scheme's own path.
    local mgr = storage.move_mgr
    if not mgr or not state or not state.path_walk or mgr.path_walk ~= state.path_walk then
        record.armed, record.synced = nil, nil
        watch_mark(record, npc, now)
        return
    end

    -- A rescue in progress: the patrol goes back the moment the NPC reaches the point it was sent to.
    if record.rescue and mgr.patrol_walk then
        if npc:position():distance_to(mgr.patrol_walk:point(record.rescue)) < rescue_reach then
            record.rescue = nil
            watch_reset(mgr)
            watch_report(npc, section, "rejoined")
            watch_mark(record, npc, now)
            return
        end
    end

    -- A team signal whose partners never became ready. sync_ok clears itself only for partners that died or
    -- went offline, so one partner stalled by any of the faults below holds the whole group indefinitely.
    if mgr.syn_signal then
        record.synced = record.synced or now
        if now - record.synced > sync_grace then
            local signal = mgr.syn_signal
            record.synced, mgr.syn_signal = nil, nil
            mgr:scheme_set_signal(signal)
            watch_report(npc, section, "sync")
        end
    else
        record.synced = nil
    end

    -- A finite wait that never armed: the state manager sets callback.begin only once the requested
    -- animation has been reached, so an animation it cannot reach means the wait that ends the section
    -- never starts. A wait of "*" carries no callback at all and is left alone - that one ends on a signal,
    -- and forcing it would step over whatever the section is waiting for.
    local states = storage.state_mgr
    local callback = states and states.callback
    if callback and callback.func and callback.timeout and not callback.begin then
        record.armed = record.armed or now
        if now - record.armed > wait_grace then
            record.armed = now
            if npc:animation_count() > 0 then npc:clear_animations() end
            if mgr.path_look_info and mgr.last_look_index and mgr.path_look_info[mgr.last_look_index] then
                mgr:time_callback()
            else
                watch_reset(mgr)
            end
            watch_report(npc, section, "wait")
        end
    else
        record.armed = nil
    end

    -- Movement that is not happening. state 1 is move_mgr walking, which it leaves only on a waypoint, so
    -- an NPC that has not covered half a metre in twenty seconds is not walking anywhere.
    if mgr.state ~= 1 then
        watch_mark(record, npc, now)
        return
    end
    local position = npc:position()
    if watch_distance(record, position) > move_epsilon * move_epsilon then
        watch_mark(record, npc, now)
        return
    end
    if now - record.moved < move_grace then return end
    record.moved = now
    -- A rescue that is not moving either gets re-planned rather than restarting the ladder, or the reset
    -- below would cancel it half way.
    if record.rescue then
        record.rescue = watch_rescue(npc, mgr)
        watch_report(npc, section, "rescue")
        return
    end
    record.tries = record.tries + 1
    if record.tries < 3 then
        -- What move_mgr itself does when a wait ends away from its waypoint: rebuild the patrol from where
        -- the NPC actually stands. The second attempt drops the remembered index with it.
        if record.tries == 2 then
            mgr.current_point_index, mgr.last_index = nil, nil
        end
        watch_reset(mgr)
        watch_report(npc, section, "reset")
    else
        record.rescue = watch_rescue(npc, mgr)
        if record.rescue then watch_report(npc, section, "rescue") end
    end
end

local function install_ai_watchdog()
    local binder = xr_motivator.motivator_binder
    local original = binder.update
    binder.update = function(self, ...)
        local result = original(self, ...)
        -- A stall check must never be able to take the game down with it.
        pcall(watch_npc, self.object)
        return result
    end
end

-- The mod's burglar skill is checked but never granted: its two journals post their "+1" and nothing declares,
-- let alone hands out, the level-1 portion the locks wait for. Level 1 therefore means both journals, which is
-- exactly how the mod's other skills reach their first level.
local burglar_journals = "{+esc_jyrnal2_s_navuk +val_jyrnal_vzlom2}"
local tikhon_door_config = [[scripts\kordon\dveri_tixona_podsobka.ltx]]
local tikhon_door_condition = "{+navuk_vzlom_lvl1}ph_door@locked"
local autopark_safe_config = [[scripts\barr\avtpark_seif.ltx]]

local function burglar_condition(npc, section, field, source)
    return field == "on_info" and section == "ph_door@locked0" and type(source) == "string" and
        string.gsub(source, "%s+", "") == tikhon_door_condition and logic_config(npc) == tikhon_door_config
end

-- The X18 terminal that carries the "enter the password" tip is meant to fall silent once the door code is
-- entered, and its own file holds the empty ph_idle2 for exactly that. The transition names sr_idle2 instead,
-- which no section on that object declares, and activate_by_section aborts on a section that does not exist -
-- so keying in the code killed the game on the spot.
local lab_terminal = "lab_psihoz113"
local lab_terminal_transition = "{+lab_minys_psiz}sr_idle2"
local lab_terminal_repaired = "{+lab_minys_psiz} ph_idle2"

local function lab_terminal_condition(npc, section, field, source)
    return field == "on_info" and section == "ph_idle" and type(source) == "string" and
        string.gsub(source, "%s+", "") == lab_terminal_transition and npc and npc:name() == lab_terminal
end

-- The ghost house's window restrictor is meant to fall silent once the scripted zombie has granted
-- esc_dom_prizraka_kiknem: every one of its own sections switches to nil on exactly that portion. Its active
-- line, though, offers only sr_idle behind the negated portion and no unconditional else, so once the portion
-- is set determine_section_to_activate picks nothing and aborts - on every later entry to Cordon, right as
-- the loading screen ends. Vanilla writes the same guard with the fallback the mod dropped.
local ghost_window_config = [[scripts\kordon_new\space_okno_prizrakdoma.ltx]]
local ghost_window_active = "{-esc_dom_prizraka_kiknem}sr_idle"
local ghost_window_repaired = "{-esc_dom_prizraka_kiknem} sr_idle, nil"

local function ghost_window_condition(npc, section, field, source)
    return field == "active" and section == "logic" and type(source) == "string" and
        string.gsub(source, "%s+", "") == ghost_window_active and logic_config(npc) == ghost_window_config
end

-- The mod renamed Lis's camper sections and left this one transition pointing at the old name. Nothing
-- reaches the section today, but a target that does not exist is a fatal the moment something does.
local fox_transition = "{+escape_stalker_done!_used}camper@esc_stalker_fox"
local fox_repaired = "{+escape_stalker_done !_used} camper@esc_stalker_foxik"

local function fox_condition(section, field, source)
    return field == "on_info" and section == "remark@esc_stalker_fox" and type(source) == "string" and
        string.gsub(source, "%s+", "") == fox_transition
end

-- The X16 grate. Vanilla holds it open, drops it once the player is past, and reopens it for good when the
-- primary emitter is shut down. The mod starts it in the fallen state and made the reopen wait for art_start,
-- which nothing in the game grants, so it is welded shut. This is the vanilla condition, restored.
local grate_config = [[scripts\yan\yan_grate.ltx]]
local grate_transition = "{+art_start}ph_door@open"
local grate_repaired = "{+yan_labx16_switcher_primary_off} ph_door@open_final"

local function grate_condition(npc, section, field, source)
    return field == "on_info" and section == "ph_door@close" and type(source) == "string" and
        string.gsub(source, "%s+", "") == grate_transition and logic_config(npc) == grate_config
end

-- Both KPSS snipers leave their post at nightfall and are told to come back to the section they are already
-- in, which switch_to_section refuses. They never return to the sniper's nest again.
local sniper_configs = {
    [ [[scripts\ded_city\nemec_sniper1_v_kpss_logic.ltx]] ] = true,
    [ [[scripts\ded_city\nemec_sniper2_v_kpss_logic.ltx]] ] = true
}
local sniper_transition = "{!is_night}kamp"
local sniper_repaired = "{!is_night} camper"

local function sniper_condition(npc, section, field, source)
    return field == "on_info" and section == "kamp" and type(source) == "string" and
        string.gsub(source, "%s+", "") == sniper_transition and sniper_configs[logic_config(npc)] == true
end

local function install_burglar_repairs()
    local original_door = ph_door.set_scheme
    ph_door.set_scheme = function(npc, ini, scheme, section, gulag_name)
        local result = original_door(npc, ini, scheme, section, gulag_name)
        local storage = db.storage[npc:id()]
        local state = storage and storage[scheme]
        -- The autopark safe's only way out of its locked state is commented out in the mod, so its "needs the
        -- burglar skill" tip was a promise nothing kept. This is that line, gated on the skill it names.
        if state and section == "ph_door@locked" and not state.on_use and
            logic_config(npc) == autopark_safe_config then
            state.on_use = {name = "on_use", condlist = xr_logic.parse_condlist(npc, section, "on_use",
                burglar_journals .. " %+bar_avtoparka_seif_otkrulsa% ph_door@open")}
        end
        return result
    end
end

-- A scripted mob's death hands out the info portions of its [death] section through the engine's death
-- callback, and nothing else ever will. A mob that dies out of sight - killed offline, or lost through the
-- level geometry from a spawn point it shared with four others - never runs that callback, and the quest
-- waiting for those portions waits for good. Such mobs are tracked from the moment they spawn, and a death the
-- callback missed still delivers exactly what the section promised. A removal by script is not a death and is
-- told apart from one below.
local death_watch = {}
local death_checked = 0
local death_period = 3000

local function death_info_fields(ini, section)
    local fields = {}
    local field, index = "on_info", 1
    while ini:line_exist(section, field) do
        fields[#fields + 1] = ini:r_string(section, field)
        index = index + 1
        field = "on_info" .. index
    end
    return fields
end

-- Only clauses without a condition. A portion given only for the actor's own kill, or under any other check,
-- is that section's decision and is left to it.
local function unconditional_portions(line, portions)
    for clause in string.gmatch(line, "%s*([^,]+)%s*") do
        local _, _, check = string.find(clause, "{(.-)}")
        if not check or not string.find(check, "%S") then
            local _, _, set = string.find(clause, "%%(.-)%%")
            for portion in string.gmatch(set or "", "%+([%w_]+)") do portions[#portions + 1] = portion end
        end
    end
end

local function death_portions(storage)
    local ini, section = storage and storage.ini, storage and storage.section_logic
    if not ini or not section or not ini:section_exist(section) or not ini:line_exist(section, "on_death") then
        return nil
    end
    local death_section = ini:r_string(section, "on_death")
    if not ini:section_exist(death_section) then return nil end
    local portions = {}
    for _, line in ipairs(death_info_fields(ini, death_section)) do unconditional_portions(line, portions) end
    return #portions > 0 and portions or nil
end

local function watch_death(binder)
    local portions = death_portions(binder.st)
    if not portions then return end
    for _, portion in ipairs(portions) do
        if not has_alife_info(portion) then
            death_watch[binder.object:id()] = {portions = portions, name = binder.object:name()}
            return
        end
    end
end

-- A release ordered by script unregisters the server object before the client copy is destroyed; an offline
-- switch keeps it. That is the difference between "deleted" and "went out of sight".
local function forget_scripted_release(id)
    if death_watch[id] and not alife():object(id) then death_watch[id] = nil end
end

local function deliver_death(id, record)
    death_watch[id] = nil
    for _, portion in ipairs(record.portions) do
        if not has_alife_info(portion) then
            db.actor:give_info_portion(portion)
            report_line("death " .. record.name .. " " .. portion)
        end
    end
end

-- The dossier the actor is meant to take off the nationalist terrorist on Agroprom carries its own PDA article,
-- but the mod only names it in a [known_info] section of his logic file, and xr_info reads that section from a
-- spawn ini, never from a logic one. Nothing ever granted it, so Karabin's nineteen-phrase reveal could not
-- open. The death portion of the same NPC is the event that stands for taking the dossier off him, and pairing
-- the two also repairs a save where he is already dead.
local paired_portions = {aro_pidr1_strelki_death = "agro_vzial_infy_s_terista_naca"}

-- The dialog in which the actor reports both of Reba's spies dead is itself called esc_reba_proverky_proshel,
-- and its closing phrase hands out esc_reba_proverky_ne_proshel - the fail portion of its own task - while the
-- completion portion the task names has no producer anywhere in the mod. So the job the player just finished
-- was stamped failed. The reward of that one phrase runs nowhere else, which is what tells the report apart
-- from the two dialogs that legitimately fail the job. The fail portion is left in place: it also starts the
-- artefact task and spawns the pit artefact, and Volk and Sidorovich both have a dialog waiting for it.
local spy_task = "esc_proverka_na_killerstvo"
local spy_task_objectives = {0, 3}
local spy_task_reported = false

-- Two of the mod's condlists run an effect from a timer with no target section. switch_to_section takes no
-- section, so the timer never re-arms and xr_logic re-applies the effect on every update instead of once:
-- Reba's spy at the antennas re-declares war on the actor every frame from the moment he comes online, and
-- the psi device stacks a fresh post-process effector every frame through its blackout, because
-- run_postprocess draws a new random id per call. Both now do exactly what one call would have done.
local postprocess_repeat = 500
local postprocess_last = {}

local function install_repeat_effect_repairs()
    local original_enemy = xr_effects.actor_enemy
    xr_effects.actor_enemy = function(actor, npc, ...)
        -- Guarded: an object this build will not answer for must still get the mod's own declaration.
        local known, current = pcall(function() return npc:relation(actor) end)
        if known and current == game_object.enemy then return end
        return original_enemy(actor, npc, ...)
    end
    local function throttled(original, key)
        return function(actor, npc, p)
            local name = p and p[1]
            if type(name) == "string" then
                local now, last = time_global(), postprocess_last[key .. name]
                if last and now - last < postprocess_repeat then return end
                postprocess_last[key .. name] = now
            end
            return original(actor, npc, p)
        end
    end
    xr_effects.run_postprocess = throttled(xr_effects.run_postprocess, "pp:")
    -- The Dead City air raid restarts the same sound every update for five and a half seconds, from a clause
    -- with no target section. A sound that is asked for again while it is still the same sound is one sound.
    xr_effects.play_snd = throttled(xr_effects.play_snd, "snd:")
end

local function install_spy_task_repair()
    local original_reward = new_life.mne_nagrada_ot_rebu_za_shpionov
    if type(original_reward) ~= "function" then return end
    new_life.mne_nagrada_ot_rebu_za_shpionov = function(...)
        local result = original_reward(...)
        if db.actor and not has_alife_info("esc_reba_proverky_proshel") then
            db.actor:give_info_portion("esc_reba_proverky_proshel")
            spy_task_reported = true
            report_line("paired esc_reba_proverky_proshel")
        end
        return result
    end
end

-- Both a completion and a fail portion end up known on these tasks, so the outcome must not depend on which
-- of the two the engine happens to test first. Each entry names the objectives that carry them.
local pending_tasks = {}

local function settle_task(id, objectives)
    pending_tasks[id] = objectives
end

local function settle_tasks()
    for id, objectives in pairs(pending_tasks) do
        pending_tasks[id] = nil
        for _, objective in ipairs(objectives) do
            pcall(function() level_tasks.set_task_state(task.completed, id, objective) end)
        end
    end
end

local function settle_spy_task()
    if not spy_task_reported then return end
    spy_task_reported = false
    settle_task(spy_task, spy_task_objectives)
end

-- Tikhon's closing line hands over "your share": the quarter million he guarantees for the ATP deal, which is the
-- price Reba names for the case. The mod never paid it, and once the pack made Reba actually charge the sum, the
-- whole Cordon line stopped at a quarter million nobody could have. The config repair puts this call on that line
-- in the same repair that wires the charge, so the money only ever exists where it is also taken. The payment is
-- remembered in the actor's pstor, the key/value table the unmodified mod saves and loads as it is.
local ransom = {
    amount = 250000, task = "esc_dobro_nunche_dorogoe", saving_objective = 1, flag = "ild_tikhon_share_paid"
}

function tikhon_share(first_speaker, second_speaker)
    local actor = db.actor
    if not actor or has_alife_info("esc_dengi_rebe") then return end
    local known, paid = pcall(xr_logic.pstor_retrieve, actor, ransom.flag, false)
    if not known or paid then return end
    xr_logic.pstor_store(actor, ransom.flag, true)
    dialogs.relocate_money(second_speaker or first_speaker or actor, ransom.amount, "in")
    report_line("share " .. ransom.amount)
end

local function install_ransom_share()
    local original = new_life.don_reba_denga_za_artu_esti
    if type(original) ~= "function" then return end
    -- A save that finished Tikhon's dialog before the share existed is paid the moment Reba is asked. Her check is
    -- called only by the repaired dialog, so this too happens only where the charge is wired.
    new_life.don_reba_denga_za_artu_esti = function(first_speaker, second_speaker, ...)
        if has_alife_info("esc_tixon_atp_final") then tikhon_share(first_speaker, second_speaker) end
        return original(first_speaker, second_speaker, ...)
    end
end

-- "Save up a quarter million" has no completion condition of its own, so it could only ever be swept along when
-- Reba's portion closed the whole task. It is what the player holds that the objective asks about.
local function settle_ransom_saving()
    local actor = db.actor
    if has_alife_info("esc_dengi_rebe") or actor:money() < ransom.amount then return end
    local known, state = pcall(function() return actor:get_task_state(ransom.task, ransom.saving_objective) end)
    if not known or state ~= task.in_progress then return end
    pcall(function() level_tasks.set_task_state(task.completed, ransom.task, ransom.saving_objective) end)
    report_line("task " .. ransom.task .. " " .. ransom.saving_objective)
end

local function deliver_paired_portions()
    for trigger, portion in pairs(paired_portions) do
        if has_alife_info(trigger) and not has_alife_info(portion) then
            db.actor:give_info_portion(portion)
            report_line("paired " .. portion)
        end
    end
end

-- The three soldiers who walk into the controller's ambush under Agroprom are meant to die there. Mozar says
-- so in his own lines - he is dead, a monster killed him, and the two sergeants too - and the Prapor's
-- final section is literally named remark@suicide. Nothing in the mod ever kills them. They hold the psy_pain
-- animation for good, because combat_ignore_cond = always makes them ignore the controller as well, and the
-- whole surface garrison sits behind {+und_prapor_dead}, which only the Prapor's own [death] section grants -
-- so the base never reacts and the branch ends with nothing left to do. Each of them now dies on its own
-- timer, the Prapor first, so the scripted scream, the PDA line and the zombie wave still land in the room.
-- Sections that hold up the story behind something that may never arrive, with the transition the section
-- itself would have made. The three Agroprom soldiers die because the scene says they did; the two remaining
-- entries only put a floor under a wait for a sound. Keyed by spawn section: all of these NPCs carry their
-- logic as custom_data, so they have no [logic] cfg to read.
local scene_fallbacks = {
    -- The Bar formation. bar_krik_konec has one producer and gates every quest of the rest of the game.
    b_kom_stroi = {remark2 = {25000, "%+bar_krik_konec% remark3"}},
    -- The SS paratroop commander. He is untalkable until camper55, and the ending dialog is only on him.
    dt_ss_desantnik_kom = {
        remark1 = {30000, "%+ddt_ss_desant_na_start% walker"},
        remark2 = {30000, "%+dt_ss_nakonecto_k_tonelq% camper55"}
    },
    und_prapor2 = {["remark@suicide"] = {12000, "%=kill%"}},
    agro_sania = {remark66 = {16000, "%=kill%"}},
    agro_pania = {remark66 = {20000, "%=kill%"}}
}
local underground_task = "agro_v_podzemky"
local underground_objectives = {0, 1}

local function install_scene_fallbacks()
    local original = xr_remark.set_scheme
    xr_remark.set_scheme = function(npc, ini, scheme, section, gulag_name)
        local result = original(npc, ini, scheme, section, gulag_name)
        local owner = npc and scene_fallbacks[npc:section()]
        local fallback = owner and owner[section]
        local storage = fallback and db.storage[npc:id()]
        local state = storage and storage[scheme]
        -- on_timer is measured from the activation time activate_by_section has just written, and set_scheme
        -- rebuilds st.logic on every activation, so this neither accumulates nor survives a section change.
        -- The delays are well past what the section needs when nothing goes wrong.
        if state and state.logic then
            table.insert(state.logic, {name = "on_timer1", v1 = fallback[1],
                condlist = xr_logic.parse_condlist(npc, section, "on_timer1", fallback[2])})
            report_line("fallback " .. npc:name() .. " " .. section)
        end
        return result
    end
end

-- Both objectives of the underground task carry und_prapor_dead as their fail portion and und_prapor_3 as
-- their completion, and the dialog that completes it always runs first. Now that the deaths actually happen,
-- the completion is re-asserted so the order the engine tests them in cannot matter.
local function settle_underground_task()
    if has_alife_info("und_prapor_dead") and has_alife_info("und_prapor_3") then
        settle_task(underground_task, underground_objectives)
    end
end

-- The branch ends with the base hostile, both Agroprom tasks already closed and no marker of any kind, while
-- the only way on is an NPC who appears in an unmarked corner of the Garbage the moment the door opens. This
-- is one of the two hints the pack adds, in the same shape the mod's own news.script uses.
-- The engine reads scripts as CP1251 while this repository keeps its sources in UTF-8, so the one
-- sentence the pack shows is assembled from its own bytes:
-- Здесь больше нечего делать. Надо возвращаться на Свалку, к повстанцам.
local garbage_hint = string.char(
    199, 228, 229, 241, 252, 32, 225, 238, 235, 252, 248, 229, 32, 237, 229, 247, 229, 227, 238, 32, 228, 229, 235,
    224, 242, 252, 46, 32, 205, 224, 228, 238, 32, 226, 238, 231, 226, 240, 224, 249, 224, 242, 252, 241, 255, 32,
    237, 224, 32, 209, 226, 224, 235, 234, 243, 44, 32, 234, 32, 239, 238, 226, 241, 242, 224, 237, 246, 224, 236,
    46)
local garbage_hint_flag = "agro_finaluch_igra"

local function story_server(story_id)
    local simulator = alife()
    return simulator and simulator:story_object(story_id) or nil
end

-- nil when the object is released, false while it is a corpse, true while it can still run its logic.
local function story_alive(story_id)
    local server = story_server(story_id)
    if not server then return nil end
    local known, alive = pcall(server.alive, server)
    return not known or alive ~= false
end

local function story_online(story_id)
    local server = story_server(story_id)
    local object = server and level.object_by_id(server.id)
    local storage = object and db.storage[object:id()]
    return storage and storage.active_scheme and object or nil, storage
end

local scene_freeze = 90000
local scene_section_since = {}

-- The section waits for a sound that is no longer playing: this is the assignment the remark scheme failed to
-- make, and nothing else in the section can end it.
local function scene_sound_ended(npc, state)
    if npc:active_sound_count() ~= 0 then return false end
    for _, condition in pairs(state.logic or {}) do
        if condition.name and string.find(condition.name, "^on_signal%d*$") and condition.v1 == "sound_end" then
            return true
        end
    end
    return false
end

-- The scene sections of this mod have no timeouts, and the schemes that run them stop being executed the
-- moment anything deselects their action - a hit that disables combat_ignore for good, a danger, an enemy.
-- Everything below is what a reload does: turn combat_ignore back on, release a wait for a sound that is no
-- longer playing, and ask the section to make its own transition. No step of any scene is skipped.
local function unfreeze_scene(npc, storage, key, now)
    local state = storage[storage.active_scheme]
    local section = state and state.section
    if not section then return false end
    local record = scene_section_since[key]
    if not record or record.section ~= section then
        scene_section_since[key] = {section = section, since = now}
        return false
    end
    if now - record.since < scene_freeze then return false end
    record.since = now
    if storage.combat_ignore then storage.combat_ignore.enabled = true end
    if scene_sound_ended(npc, state) then
        state.signals = state.signals or {}
        state.signals["sound_end"] = true
    end
    xr_logic.try_switch_to_another_section(npc, state, db.actor)
    watch_report(npc, section, "scene")
    return true
end

-- The same scenes, watched from the actor's side: an action that is never selected cannot reach the timer
-- above, and an NPC that is gone cannot reach anything at all.
local scene_owners = {
    b_kom_stroi = true, dt_ss_desantnik_kom = true, bar_letiagin_final2 = true,
    und_prapor2 = true, agro_sania = true, agro_pania = true
}

-- NPCs whose loss cannot be recovered from, remembered from the moment they spawn so their absence can be
-- told apart from "not spawned yet" without scanning the whole simulation.
local critical_sections = {bar_melisa_nyjen_tyt = true}
local critical_npc = {}

local function watch_critical(binder)
    local section = binder.object:section()
    if critical_sections[section] then critical_npc[section] = binder.object:id() end
end

local function check_scene_stalls(now)
    for id, storage in pairs(db.storage) do
        if storage.active_scheme then
            local object = level.object_by_id(id)
            -- db.storage also holds restrictors and physic objects, which answer for a section differently.
            local known, section = pcall(function() return object:section() end)
            if known and scene_owners[section] then
                pcall(unfreeze_scene, object, storage, "scene:" .. id, now)
            end
        end
    end
end

-- A scene whose only producer is gone for good. Each entry hands over exactly what the section it replaces
-- would have handed over, and only once the grace period proves nothing else is coming.
local last_resort = {
    -- The Bar formation commander is an ordinary stalker, so unlike the mod's other scene NPCs he can die.
    {after = {"bar_v_stroi"}, missing = "bar_krik_konec", grace = 180000},
    -- The rally countdown is paid for in advance and its dialog cannot be re-run.
    {after = {"ddt_rally_otschet"}, missing = "dt_ralli_strt", grace = 40000},
    -- The countdown itself comes from one driver, who reacts to the bet the moment it is placed. Whichever of the
    -- three bets was taken, a driver who is dead or gone must not keep the paid race from starting.
    {after = {"dt_ralli_nachalo1", "dt_ralli_nachalo2", "dt_ralli_nachalo3"}, missing = "ddt_rally_otschet",
        grace = 30000}
}
local last_resort_since = {}

local function deliver_last_resort(now)
    for index, rule in ipairs(last_resort) do
        local armed = false
        for _, portion in ipairs(rule.after) do armed = armed or has_alife_info(portion) end
        if armed and not has_alife_info(rule.missing) then
            last_resort_since[index] = last_resort_since[index] or now
            if now - last_resort_since[index] >= rule.grace then
                db.actor:give_info_portion(rule.missing)
                report_line("scene " .. rule.missing)
            end
        else
            last_resort_since[index] = nil
        end
    end
end

-- Letyagin's farewell hides the HUD and disables input, and the only thing that ever gives them back is a
-- distance check on the walk he then takes - while a restrictor teleports the actor back to the same spot
-- until that walk reports in. A walk that cannot be built therefore locks the player out of the game with no
-- way back. This runs the section's own line instead: the stash, the portion and the input.
local letyagin_grace = 120000
local letyagin_since

local function release_letyagin(now)
    if not has_alife_info("bar_letia_final") or has_alife_info("barar_vse_letiaga_yshel") then
        letyagin_since = nil
        return
    end
    letyagin_since = letyagin_since or now
    if now - letyagin_since < letyagin_grace then return end
    letyagin_since = now
    local simulator = alife()
    local owner
    for id, storage in pairs(db.storage) do
        local object = storage.active_scheme and level.object_by_id(id)
        if object and object:section() == "bar_letiagin_final2" then owner = object end
    end
    pcall(function() xr_effects.dt_final_rndm_tainik(db.actor, owner) end)
    db.actor:give_info_portion("barar_vse_letiaga_yshel")
    pcall(function() xr_effects.enable_ui(db.actor, owner) end)
    if owner and simulator then
        local server = simulator:object(owner:id())
        if server then simulator:release(server, true) end
    end
    report_line("scene barar_vse_letiaga_yshel")
end

-- The nuke defuser has one source: Melisa, at the end of a chain that starts mid-game. Every one of the seven
-- finale devices tests for it, and the portion that opens the ending comes only from the seventh.
local function deliver_defuser()
    if not has_alife_info("barar_vse_letiaga_yshel") or has_alife_info("bar_melisa_finish") then return end
    local id = critical_npc.bar_melisa_nyjen_tyt
    local simulator = alife()
    if not id or not simulator or simulator:object(id) then return end
    local actor = db.actor
    simulator:create("bar_deaktiv_iaderki", actor:position(), actor:level_vertex_id(),
        actor:game_vertex_id(), actor:id())
    actor:give_info_portion("bar_melisa_finish")
    report_line("scene bar_deaktiv_iaderki")
end

-- The X18 entrance door was changed to start open, which leaves [ph_door@locked] unreachable - and its on_use
-- is the only producer of val_x18_door_open and dar_run_quest anywhere in the mod. Without them the lab task
-- never completes, the Barman never takes the documents, the X16 task is never given and his stock never
-- improves. Both portions mean "the way into the lab is open", so reaching the lab, or holding the two keys
-- the door asked for, stands in for the use that can no longer happen. The door itself is left open: a player
-- already inside would be sealed in by locking it again.
local function open_x18_chain()
    if has_alife_info("val_x18_door_open") then return end
    if not has_alife_info("labx_nachalo_pizdeca") and not (has_alife_info("val_actor_has_barman_key") and
        has_alife_info("val_actor_has_borov_key")) then return end
    db.actor:give_info_portion("val_x18_door_open")
    if not has_alife_info("dar_run_quest") then db.actor:give_info_portion("dar_run_quest") end
    report_line("scene val_x18_door_open")
end

-- The restrictor that plays the X18 closing cutscene waits for the pseudogiant to leave the pit, and a corpse
-- never leaves anything. That wait is the only path to labx_konec_psevducha, which the finale task, the
-- cutscene giant's own removal and two locked doors all hang on.
local x18_giant_story = 455
local x18_pit_grace = 60000
local x18_giant_seen, x18_pit_since

local function check_x18_pit(now)
    if has_alife_info("labx_konec_psevducha") then return end
    local server = story_server(x18_giant_story)
    if server then
        x18_giant_seen = true
        local known, alive = pcall(server.alive, server)
        if not known or alive ~= false then
            x18_pit_since = nil
            return
        end
    elseif not x18_giant_seen then
        return
    end
    x18_pit_since = x18_pit_since or now
    if now - x18_pit_since < x18_pit_grace then return end
    db.actor:give_info_portion("labx_konec_psevducha")
    report_line("scene labx_konec_psevducha")
end

local function install_level_repairs()
    -- The four village bloodsuckers were dropped from the spawn, so the portions their death sections carried
    -- have no producer and two of Ugrumy's tasks can never close. The three restrictors that used to arm them
    -- still fire, and walking the village past all three is the surviving proof the area was cleared.
    local original_hunt = mil_tasks.bloodsuckers_dead
    mil_tasks.bloodsuckers_dead = function(...)
        if has_alife_info("mil_village_bloodsucker1") and has_alife_info("mil_village_bloodsucker2") and
            has_alife_info("mil_village_bloodsucker3") then return true end
        return original_hunt(...)
    end
    -- Lukash still hands out the order to destroy a Duty group whose leader and zone guard were removed from
    -- the spawn, so neither objective can ever be met. A task that cannot be done is reported as failed rather
    -- than left in the PDA for the rest of the game.
    local original_lukash = mil_tasks.lukash_job_fail
    mil_tasks.lukash_job_fail = function(...)
        local simulator = alife()
        if simulator and not (simulator:story_object(702) and simulator:story_object(708)) then return true end
        return original_lukash(...)
    end
    -- The community table was re-skinned to monolith and vrag while the job lists still name the freedom and
    -- dolg profiles, so nobody could fill those jobs: Ugrumy and the blockpost commander never receive the
    -- meet dialog that is their only way of being spoken to.
    local original_check = gulag_military.checkStalker
    gulag_military.checkStalker = function(npc_community, gulag_type, ...)
        if npc_community == "freedom" and (gulag_type == "mil_village" or gulag_type == "mil_fblockpost" or
            gulag_type == "mil_fneutral") then return true end
        if npc_community == "dolg" and gulag_type == "mil_dolg" then return true end
        return original_check(npc_community, gulag_type, ...)
    end
    -- Mazai's last dialog waits for an artefact with no section and no spawner; the step before it is what the
    -- player can actually reach.
    dolina_skripts.esti_art_gemchyg = function() return has_alife_info("val_kom_mazai_4") end
    -- Its scene would have created a zone section that exists nowhere. Nothing calls this today, and nothing
    -- should be able to make it fatal later either.
    dolina_skripts.spawn_sirena = function() end
    new_life.test_test_test = new_life.test_test_test or function() end
    -- The CNPP surge was commented out of this timer, but the section it lives in kept running with no exit,
    -- so the counter reached zero and stayed on the HUD for the rest of the level, captioned with the raw
    -- string id the commented-out line left behind. An exit at zero lets the scheme take its own statics down.
    local original_timer = sr_timer.set_scheme
    sr_timer.set_scheme = function(object, ini, scheme, section, gulag_name)
        local result = original_timer(object, ini, scheme, section, gulag_name)
        if object:name() == "aes_space_restrictor_timer" then
            local storage = db.storage[object:id()]
            local state = storage and storage[scheme]
            if state and not state.on_value then
                state.on_value = sr_timer.parse_data(object, "0|nil")
                report_line("timer " .. object:name())
            end
        end
        return result
    end
end

-- The Monolith destruction has one producer for sar_monolith_destroy - the alarm section's sound_end - and
-- that portion is the only route into the room where the game ends. Six generators down with the portion
-- still missing means the signal never landed.
local monolith_counter = "mon_destroy_generator"
local monolith_grace = 45000
local monolith_since

local function check_monolith(now)
    if has_alife_info("sar_monolith_destroy") then
        monolith_since = nil
        return
    end
    local known, counter = pcall(xr_logic.pstor_retrieve, db.actor, monolith_counter, 0)
    if not known or (counter or 0) < 6 then
        monolith_since = nil
        return
    end
    monolith_since = monolith_since or now
    if now - monolith_since < monolith_grace then return end
    db.actor:give_info_portion("sar_monolith_destroy")
    if not has_alife_info("sar_monolith_off") then db.actor:give_info_portion("sar_monolith_off") end
    report_line("scene sar_monolith_destroy")
end

-- The brain-scorcher blackout hides the HUD and disables input, and hands them back only at the end of three
-- waits with no timeout of their own: a sound, a movie and another sound. Any one of them failing leaves the
-- player with no controls for the rest of the save. The dream is not replayed - only what was owed is paid.
local blackout_grace = 120000
local blackout_since

local function release_blackout(now)
    if not has_alife_info("bun_actor_fall") or has_alife_info("bun_antenna_off") then
        blackout_since = nil
        return
    end
    blackout_since = blackout_since or now
    if now - blackout_since < blackout_grace then return end
    blackout_since = now
    db.actor:give_info_portion("sar_monolith_call")
    db.actor:give_info_portion("bun_antenna_off")
    pcall(function() xr_effects.enable_ui(db.actor, nil) end)
    report_line("scene bun_antenna_off")
end

-- The five control-room guards hand their part of the door counter over as an effect rather than an info
-- portion, so the death watch above cannot make good a death its callback missed - and that counter alone
-- opens the door to the generator hall. The counter is set to what five deaths are worth, never incremented,
-- so this can neither run ahead of the deaths that did register nor count any of them twice.
local control_room_counter = "mon_clear_control_room"
local control_room_guards = {}

local function watch_control_room(binder)
    local name = binder.object:name()
    if string.find(name, "^mon_stalker_walker4_%d+$") then control_room_guards[name] = binder.object:id() end
end

local function settle_control_room()
    if has_alife_info("mon_door_unlocked") then return end
    local simulator = alife()
    if not simulator then return end
    local counted = 0
    for _, id in pairs(control_room_guards) do
        local server = simulator:object(id)
        if server then
            local known, alive = pcall(server.alive, server)
            if not known or alive ~= false then return end
        end
        counted = counted + 1
    end
    if counted < 5 then return end
    local known, counter = pcall(xr_logic.pstor_retrieve, db.actor, control_room_counter, 0)
    if not known or (counter or 0) >= 5 then return end
    xr_logic.pstor_store(db.actor, control_room_counter, 5)
    report_line("scene " .. control_room_counter)
end

local function deliver_garbage_hint()
    if not has_alife_info("agro_door_open") or has_alife_info(garbage_hint_flag) then return end
    db.actor:give_info_portion(garbage_hint_flag)
    db.actor:give_game_news(garbage_hint, [[ui\ui_npc_monster]], Frect():set(0, 215, 163, 105), 0, 20000)
    pcall(function() xr_sound.get_safe_sound_object([[device\pda\pda_objective]])
        :play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0) end)
    report_line("hint " .. garbage_hint_flag)
end

-- The ATP scene is a ping-pong of remark sections between the spetsnaz leader (story 41) and Tikhon (42):
-- each waits for its own sound to end or for the portion the other hands over, and the leader's last section
-- is the only place in the whole mod that grants esc_atp_ydalai_ysex_k_xyiam_end - the portion Tikhon's
-- closing dialog waits for. Nothing in the chain has a timeout, so one interruption strands it with the
-- helicopter already gone and Tikhon offering nothing but a greeting. Every recovery below re-runs only what
-- the scene itself would have run next.
local atp_leader, atp_tikhon = 41, 42
local atp_end_portion = "esc_atp_ydalai_ysex_k_xyiam_end"
local atp_gone_grace = 5000
local atp_gone_since = {}

-- A release seen one tick before the portion it comes with is not a stranded scene.
local function atp_gone_for_good(key, now)
    atp_gone_since[key] = atp_gone_since[key] or now
    return now - atp_gone_since[key] >= atp_gone_grace
end

local function atp_unfreeze(story_id, now)
    local npc, storage = story_online(story_id)
    if not npc then return false end
    return unfreeze_scene(npc, storage, story_id, now)
end

local function check_atp_scene(now)
    if has_alife_info(atp_end_portion) or not has_alife_info("atp_sdelka_t_fraza1") then return end
    local leader = story_alive(atp_leader)
    -- A dead or released leader never runs his logic again: net_spawn returns before the schemes are set up,
    -- so no reload recovers him and no section of his can reach the helicopter he was looking at.
    if leader ~= true then
        if atp_gone_for_good("leader", now) then
            db.actor:give_info_portion(atp_end_portion)
            report_line("scene " .. atp_end_portion)
        end
        return
    end
    atp_gone_since.leader = nil
    -- Tikhon is the only source of fraza7. With him gone the leader can still play the rest of the scene out
    -- himself and grant the closing portion through the mod's own condlist.
    if story_alive(atp_tikhon) ~= true then
        if has_alife_info("atp_sdelka_t_fraza6") and not has_alife_info("atp_sdelka_t_fraza7") and
            atp_gone_for_good("tikhon", now) then
            db.actor:give_info_portion("atp_sdelka_t_fraza7")
            report_line("scene atp_sdelka_t_fraza7")
        end
        return
    end
    atp_gone_since.tikhon = nil
    -- Either of them can be the frozen one while the other is legitimately waiting on it, so both are checked.
    atp_unfreeze(atp_leader, now)
    atp_unfreeze(atp_tikhon, now)
end

-- Tikhon's closing dialog is the only source of esc_tixon_atp_final, and Reba's ransom dialog waits for it. A
-- Tikhon who dies after the ATP scene - the pack itself plays that scene out for a dead one - would take the rest
-- of the Cordon line with him, so once he is gone for good his dialog counts as said. The share still arrives only
-- through the repaired dialogs.
local function settle_tikhon_final(now)
    if not has_alife_info(atp_end_portion) or has_alife_info("esc_tixon_atp_final") or
        story_alive(atp_tikhon) == true then
        atp_gone_since.final = nil
        return
    end
    if not atp_gone_for_good("final", now) then return end
    db.actor:give_info_portion("esc_tixon_atp_final")
    report_line("scene esc_tixon_atp_final")
end

-- The Wild Territory rally is staged behind the level's own invisible walls - the organizer says as much. A door on
-- the playable side teleports the actor in, and nothing ever takes him out: the teleport that follows the finish
-- lands in the start camp, which is behind the same walls, and one issued while he still sits in his car is lost
-- outright, since the car rewrites its driver's position every frame. The coordinates come from the level's
-- collision and AI meshes: the door's own wall, the spot it teleports to, and the AI node just outside that wall.
-- The block keeps its helpers to itself: a Lua 5.1 chunk may hold no more than 200 active locals.
local check_rally, install_rally_repairs
do
    local rally_level = "l06_rostok"
    local rally_quest = "spawn_sikret_rally_kvest"
    local rally_camp = {x = -115.25, z = 49.35}
    local rally_arrival = {x = -211.6, z = 11.53}
    local rally_wall = {ax = -214.39, az = 10.66, bx = -204.91, bz = 27.01}
    local rally_exit_vertex = 23123
    local rally_exit = {x = -215.6, y = 0, z = 12.6}
    -- Everything behind the walls from the start camp to the finish, and no node of the playable side above y = -3.
    local rally_area = {
        {-158, 86}, {-146, 96}, {-140, 104}, {-62, 104}, {-62, -80}, {-120, -85}, {-150, -105}, {-160, -250},
        {-185, -270}, {-185, -420}, {-375, -420}, {-375, -80}, {-195, -80}, {-178, -62}, {-165, -30}, {-160, -5}
    }
    local rally_floor = -3
    local rally_exit_hold = 3000
    local rally_over_grace = 20000
    local rally_abandoned_grace = 300000
    local rally = {}

    local function flat_distance(position, point)
        local dx, dz = position.x - point.x, position.z - point.z
        return math.sqrt(dx * dx + dz * dz)
    end

    local function inside_polygon(polygon, x, z)
        local inside, previous = false, polygon[#polygon]
        for _, point in ipairs(polygon) do
            if (point[2] > z) ~= (previous[2] > z) and
                x < (previous[1] - point[1]) * (z - point[2]) / (previous[2] - point[2]) + point[1] then
                inside = not inside
            end
            previous = point
        end
        return inside
    end

    local function in_rally_area(position)
        return position.y >= rally_floor and inside_polygon(rally_area, position.x, position.z)
    end

    -- On the rally side of the door's wall and within reach of the spot the door teleports to.
    local function near_rally_arrival(position, reach)
        local ax, az = rally_wall.bx - rally_wall.ax, rally_wall.bz - rally_wall.az
        local side = ax * (position.z - rally_wall.az) - az * (position.x - rally_wall.ax)
        return side / math.sqrt(ax * ax + az * az) < -0.3 and flat_distance(position, rally_arrival) <= reach
    end

    local function on_rally_level()
        local known, name = pcall(level.name)
        return known and name == rally_level
    end

    local function actor_seated(actor)
        local known, holder = pcall(function() return actor:get_current_holder() end)
        return known and holder ~= nil
    end

    local function leave_rally(actor, reason)
        local target = vector():set(rally_exit.x, rally_exit.y, rally_exit.z)
        local known, node = pcall(level.vertex_position, rally_exit_vertex)
        if known and node and flat_distance(node, rally_exit) <= 1 then target = node end
        actor:set_actor_position(target)
        report_line("rally " .. reason)
    end

    function check_rally(now)
        if not has_alife_info(rally_quest) or not on_rally_level() then return end
        local actor = db.actor
        if actor_seated(actor) then return end
        local position = actor:position()
        -- The way back the mod never built: having walked off the spot the door put him on, the player stands on it
        -- again. Only the player's own move triggers this, so a race in progress is never interrupted.
        if flat_distance(position, rally_arrival) >= 6 then rally.left_arrival = true end
        if rally.left_arrival and near_rally_arrival(position, 3) then
            rally.exit_since = rally.exit_since or now
            if now - rally.exit_since < rally_exit_hold then return end
            rally.exit_since, rally.left_arrival = nil, nil
            leave_rally(actor, "door")
            return
        end
        rally.exit_since = nil
        if not has_alife_info("ddt_tp_gg_nastart") or actor:is_talking() or not in_rally_area(position) then return end
        local closed = has_alife_info("dt_ralli_gg_win") or has_alife_info("dt_ralli_gg_fail")
        -- The return the finish owed and a seated driver never got: the organizer with the reward is at the camp.
        if not closed and not rally.returned and flat_distance(position, rally_camp) > 30 then
            rally.returned = true
            dik_ter.ddt_tpt_rally_na_start()
            report_line("rally return")
            return
        end
        -- The show is over once the organizer has had his say, or long after the finish if nobody talks to him.
        if rally.released then return end
        rally.finished_since = rally.finished_since or now
        if closed then rally.closed_since = rally.closed_since or now end
        if (rally.closed_since and now - rally.closed_since >= rally_over_grace) or
            now - rally.finished_since >= rally_abandoned_grace then
            rally.released = true
            leave_rally(actor, "over")
        end
    end

    function install_rally_repairs()
        local original_entry = xr_effects.ddt_tptator_na_trasy_ralli
        if type(original_entry) == "function" then
            xr_effects.ddt_tptator_na_trasy_ralli = function(...)
                -- A player who comes back through the door after the show leaves on his own feet, not on a timer.
                rally.left_arrival, rally.exit_since = nil, nil
                if has_alife_info("ddt_tp_gg_nastart") then rally.released = true end
                return original_entry(...)
            end
        end
        local original_return = dik_ter.ddt_tpt_rally_na_start
        if type(original_return) ~= "function" then return end
        dik_ter.ddt_tpt_rally_na_start = function(...)
            local actor = db.actor
            if actor and on_rally_level() then
                local position = actor:position()
                -- A race that resolves while the player is somewhere else no longer pulls him behind the walls, and one
                -- that resolves while he is seated is delivered by the watch once he gets out.
                if not in_rally_area(position) and not near_rally_arrival(position, 60) then return end
                if actor_seated(actor) then return end
                rally.returned = true
            end
            return original_return(...)
        end
    end
end

local function check_death_watch(now)
    if now - death_checked < death_period then return end
    death_checked = now
    local simulator = alife()
    if not simulator or not db.actor then return end
    deliver_paired_portions()
    settle_spy_task()
    settle_underground_task()
    deliver_garbage_hint()
    pcall(check_scene_stalls, now)
    deliver_last_resort(now)
    release_letyagin(now)
    deliver_defuser()
    open_x18_chain()
    pcall(check_x18_pit, now)
    check_monolith(now)
    release_blackout(now)
    settle_control_room()
    settle_tasks()
    pcall(check_atp_scene, now)
    pcall(settle_tikhon_final, now)
    pcall(settle_ransom_saving)
    pcall(check_rally, now)
    for id, record in pairs(death_watch) do
        local server = simulator:object(id)
        local dead = server == nil
        if server then
            local known, alive = pcall(server.alive, server)
            dead = known and alive == false
        end
        if dead then deliver_death(id, record) end
    end
end

-- The mod removes scenery and NPCs by script all over the place. A watched object that disappears while one of
-- those removal functions runs was deleted, not killed.
local function guard_scripted_release(module, name)
    local original = module and module[name]
    if type(original) ~= "function" then return end
    module[name] = function(...)
        local simulator = alife()
        local present = {}
        if simulator then for id in pairs(death_watch) do present[id] = simulator:object(id) ~= nil end end
        local results = {original(...)}
        if simulator then
            for id, was in pairs(present) do
                if was and not simulator:object(id) then death_watch[id] = nil end
            end
        end
        return unpack(results)
    end
end

local function install_death_repairs()
    for _, binder in ipairs({bind_monster.generic_object_binder, xr_motivator.motivator_binder}) do
        local original_spawn = binder.net_spawn
        binder.net_spawn = function(self, ...)
            local result = original_spawn(self, ...)
            if result then
                pcall(watch_death, self)
                pcall(watch_critical, self)
                pcall(watch_control_room, self)
            end
            return result
        end
        local original_destroy = binder.net_destroy
        binder.net_destroy = function(self, ...)
            pcall(forget_scripted_release, self.object:id())
            return original_destroy(self, ...)
        end
    end
    for name in pairs(delete) do guard_scripted_release(delete, name) end
    for _, name in ipairs({"remove_object", "remove_obj_id", "delme", "delme2"}) do
        guard_scripted_release(xr_effects, name)
    end
    guard_scripted_release(dead_city, "exterminate_nacsamlet")
    guard_scripted_release(ogsm_mutants, "safely_destroy_creature")
    guard_scripted_release(ogsm_mutants.MutantManager, "update")
end

local function install_mob_death_repair()
    local death_class = mob_death.mob_death
    local original = death_class.death_callback
    death_class.death_callback = function(self, victim, who)
        if who then return original(self, victim, who) end
        -- The unknown-killer branch writes to a local that only the known-killer branch declares, so a death
        -- with no killer aborted before the section's own portions were handed out.
        local storage = db.storage[victim:id()]
        if storage then
            storage.death = storage.death or {}
            storage.death.killer, storage.death.killer_name = -1, nil
        end
        xr_logic.try_switch_to_another_section(victim, self.st, db.actor)
    end
end

function install()
    if installed then return end
    if not new_life.new_gg_2 then new_life.new_gg_2 = moa_agro.new_gg_2 end
    if not new_life.dengi_esti then
        new_life.dengi_esti = function() return db.actor and db.actor:money() >= 3000 or false end
    end
    if not new_life.give_baaablo then
        new_life.give_baaablo = function(first_speaker, second_speaker)
            if new_life.dengi_esti() then dialogs.relocate_money(second_speaker, 3000, "out") end
        end
    end
    if not delete.esc_ydalaem_bbbbbbbbbbbbbtttttttttttrrrrr then
        delete.esc_ydalaem_bbbbbbbbbbbbbtttttttttttrrrrr = delete.esc_ydalaem_bbbbbbbbbbbbbtttttttttttrrrrrrrrrrrrr
    end
    -- The ghost's grave on the Garbage carries two of everything: both candle boxes stand on the same point, and
    -- the mound the actor digs was placed in all.spawn and then again by decor.spawn_gar_mogila_prizrak_dkr1
    -- twenty-two centimetres away. Each pair has one copy with the guard the quest needs and one without, and which
    -- copy the crosshair takes is chance. Every line below gives the copy that was left behind what its twin
    -- already says. The objects are named by section rather than by logic file: each is created from its own
    -- system.ltx section, so it carries that section's custom_data directly and has no [logic] cfg to match on.
    local soul_quest_lines = {
        -- gar_porchy_bolshe_na_davati completes both objectives of the soul task and is the flag that stops the
        -- curse being handed back; the all.spawn mound is its only producer. Digging the script-spawned one
        -- destroys the af_soul the player came for, leaves the task in the PDA for good, and - because the
        -- re-issue timer below is already running and never tests for the artefact - hands back a fresh
        -- af_porcha within thirty seconds.
        {
            owner = "gar_zemlia_dlia_dyshi", by_section = true, section = "ph_idle2", field = "on_timer",
            broken = "3000|%=remove_item(af_porcha)=remove_item(af_soul)%nil",
            repaired = "3000 | %=remove_item(af_porcha) =remove_item(af_soul) +gar_porchy_bolshe_na_davati% nil"
        },
        -- The older of the two candle boxes was never given the gate its twin carries, so the candles can be lit
        -- before the ghost has ever been spoken to. The second conversation asks only for the candles, and both
        -- ghosts share one profile whose start dialog is that second conversation - so a player holding matches
        -- takes the task, buries the af_soul and closes the quest without the curse it is about ever existing.
        {
            owner = "grar_grsvecha", section = "ph_idle1", field = "on_use",
            broken = [[{=actor_has_item(item_spichki)}%=play_snd(new\spichki)]] ..
                [[=play_snd(anomaly\emi_blowout)+gar_gg_svechy_podjeg_s_magilu%ph_idle2]],
            repaired = [[{+gar_dialog_s_prizrakom =actor_has_item(item_spichki)} %=play_snd(new\spichki) ]] ..
                [[=play_snd(anomaly\emi_blowout) +gar_gg_svechy_podjeg_s_magilu% ph_idle2]]
        },
        -- The restrictor that keeps af_porcha on the belt destroys it and creates it again every thirty seconds.
        -- Its section is entered while the actor holds one, but the timer itself tests only the completion
        -- portion, so an af_porcha put in a box inside that window is not the one removed: the pair leaves the
        -- stashed artefact where it is and adds a second. The removal is given the condition the section's own
        -- entry already uses, and a fallback back to that entry so the check is not repeated every frame.
        {
            owner = "grar_porcha_perezagryzka_spacer", section = "sr_idle2", field = "on_timer",
            broken = "30000|{-gar_porchy_bolshe_na_davati}%=remove_item(af_porcha)=mne_porchy_art%sr_idle1",
            repaired = "30000 | {-gar_porchy_bolshe_na_davati =actor_has_item(af_porcha)} " ..
                "%=remove_item(af_porcha) =mne_porchy_art% sr_idle1, sr_idle1"
        },
        -- The stash that hides the quest's af_soul is the only lock in the mod whose failed pick says nothing at
        -- all: the other six all answer with device\xrysti. A lockpick that disappears in silence reads as a dead
        -- box, and this is the one box the quest cannot be finished without. Only the missing answer is added;
        -- how often the lock resists is the mod's own and is left exactly as it was written.
        {
            owner = "gar_tainik_dvyx_s_artami", by_section = true, section = "ph_idle", field = "on_use",
            broken = [[{=actor_has_item(otmuchki)~20}%=minys_otmuchka%,]] ..
                [[{=actor_has_item(otmuchki)~40}%=minys_otmuchka=play_snd(device\klyuch)%nil,]] ..
                [[{=actor_has_item(otmuchki)~60}%=play_snd(device\klyuch)%nil]],
            repaired = [[{=actor_has_item(otmuchki) ~20} %=minys_otmuchka =play_snd(device\xrysti)%, ]] ..
                [[{=actor_has_item(otmuchki) ~40} %=minys_otmuchka =play_snd(device\klyuch)% nil, ]] ..
                [[{=actor_has_item(otmuchki) ~60} %=play_snd(device\klyuch)% nil]]
        }
    }

    local function soul_quest_repair(npc, section, field, source)
        if not npc or type(source) ~= "string" then return nil end
        local stripped
        for _, line in ipairs(soul_quest_lines) do
            if line.field == field and line.section == section then
                stripped = stripped or string.gsub(source, "%s+", "")
                if stripped == line.broken then
                    local known, owner = pcall(function()
                        if line.by_section then return npc:section() end
                        return npc:name()
                    end)
                    if known and owner == line.owner then return line.repaired end
                end
            end
        end
        return nil
    end

    local original_parse = xr_logic.parse_condlist
    xr_logic.parse_condlist = function(npc, section, field, source)
        -- Inline all.spawn logic contains extra damage triggers that must remain untouched.
        if field == "on_info" and giant_sections[section] and type(source) == "string" and
            string.gsub(source, "%s+", "") == string.gsub(giant_bad_transition, "%s+", "") and npc and
            npc:name() == "labx_psevdogiant" and npc:section() == "gigant_strong" then
            source = string.gsub(source, "mob_walker@6", "mob_walker@5", 1)
        end
        if burglar_condition(npc, section, field, source) then source = burglar_journals .. " ph_door@locked" end
        if lab_terminal_condition(npc, section, field, source) then source = lab_terminal_repaired end
        if ghost_window_condition(npc, section, field, source) then source = ghost_window_repaired end
        if fox_condition(section, field, source) then source = fox_repaired end
        if grate_condition(npc, section, field, source) then source = grate_repaired end
        if sniper_condition(npc, section, field, source) then source = sniper_repaired end
        source = soul_quest_repair(npc, section, field, source) or source
        return original_parse(npc, section, field, source)
    end
    local menu = ui_main_menu.main_menu
    local original_credits = menu.OnButton_credits_clicked
    menu.OnButton_credits_clicked = function(self, ...)
        if db.actor then return original_credits(self, ...) end
        game.start_tutorial("credits_seq")
    end

    sound_theme.ph_snd_themes.moa_psi_antena = {[[characters_voice\scenario\yantar\psy_voices_1]]}
    sound_theme.ph_snd_themes.grey_grey_later = {[[characters_voice\scenario\garbage\grey_grey_later]]}
    install_monster_death()
    install_dialog_repairs()
    install_world_repairs()
    install_sound_repairs()
    install_radio_volume()
    install_npc_repairs()
    install_ai_watchdog()
    install_hud_repairs()
    install_workbench_repairs()
    install_shovel_repairs()
    pcall(install_car_repairs)
    install_text_repairs()
    install_zone_update(se_zones.se_zone_anom, cse_anomalous_zone)
    install_zone_update(se_zones.se_zone_visual, cse_zone_visual)
    install_stash_repairs()
    install_burglar_repairs()
    install_death_repairs()
    install_mob_death_repair()
    install_story_object_repair()
    install_smart_terrain_repair()
    install_spy_task_repair()
    install_ransom_share()
    pcall(install_rally_repairs)
    install_scene_fallbacks()
    install_level_repairs()
    install_repeat_effect_repairs()

    -- The depot ambush on the Garbage keeps spawning tushkans for as long as the karlik behind it lives: his own
    -- logic re-grants gr_depo_krus_podgon every ten seconds and every grant spawns three more. Killing him is the
    -- whole answer and nothing in the mod says so, so the wave reads as a broken quest - it is the complaint
    -- players bring. One line, once, twenty seconds after the ambush starts, in the shape the mod's own
    -- news.script uses, and never after the karlik is already dead. The engine reads scripts as CP1251 while this
    -- repository keeps its sources in UTF-8, so the sentence is assembled from its own bytes:
    -- Что-то тут нечисто. Как будто, мутантами кто-то управляет. Надо бы поискать вокруг.
    local depo_hint = {
        armed = "gar_depo_napadenie_nachalosi", over = "gr_depo_krus_podox", flag = "ild_depo_karlik_hint",
        delay = 20000,
        text = string.char(
            215, 242, 238, 45, 242, 238, 32, 242, 243, 242, 32, 237, 229, 247, 232, 241, 242, 238, 46, 32, 202,
            224, 234, 32, 225, 243, 228, 242, 238, 44, 32, 236, 243, 242, 224, 237, 242, 224, 236, 232, 32, 234,
            242, 238, 45, 242, 238, 32, 243, 239, 240, 224, 226, 235, 255, 229, 242, 46, 32, 205, 224, 228, 238,
            32, 225, 251, 32, 239, 238, 232, 241, 234, 224, 242, 252, 32, 226, 238, 234, 240, 243, 227, 46)
    }
    local function deliver_depo_hint(now)
        if not db.actor or not has_alife_info(depo_hint.armed) or has_alife_info(depo_hint.over) then return end
        -- The actor's own pstor, which the unmodified mod saves and loads as is, so the line survives a reload
        -- without a portion of our own in the registry.
        local known, shown = pcall(xr_logic.pstor_retrieve, db.actor, depo_hint.flag, 0)
        if not known or (shown or 0) ~= 0 then return end
        depo_hint.since = depo_hint.since or now
        if now - depo_hint.since < depo_hint.delay then return end
        xr_logic.pstor_store(db.actor, depo_hint.flag, 1)
        db.actor:give_game_news(depo_hint.text, [[ui\ui_npc_monster]], Frect():set(0, 215, 163, 105), 0, 20000)
        pcall(function() xr_sound.get_safe_sound_object([[device\pda\pda_objective]])
            :play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0) end)
        report_line("hint " .. depo_hint.flag)
    end

    local binder = bind_stalker.actor_binder
    local original_load = binder.load
    binder.load = function(self, ...)
        local result = original_load(self, ...)
        restore_input_timeout(self)
        return result
    end
    local original_spawn = binder.net_spawn
    binder.net_spawn = function(self, ...)
        local result = original_spawn(self, ...)
        overlay = nil
        if result and db.actor then
            install_actor_repairs()
            reset_detector_registry()
        end
        return result
    end
    local original_destroy = binder.net_destroy
    binder.net_destroy = function(self, ...)
        -- The inventory window is recreated with the level; a stale overlay owner must never be touched.
        overlay = nil
        return original_destroy(self, ...)
    end
    local original_update = binder.update
    binder.update = function(self, ...)
        restore_input_timeout(self)
        if db.actor then install_actor_repairs() end
        original_update(self, ...)
        if db.actor and not detector_started then
            install_actor_repairs()
            bind_det_arts.start_update()
        end
        -- Several zones can respawn in one simulation batch; reconcile only once here.
        if db.actor and artefacts_dirty and reconcile_artefacts() then artefacts_dirty = false end
        pcall(check_death_watch, time_global())
        pcall(deliver_depo_hint, time_global())
    end
    installed = true
end
