local next_poll = 0
local status = {}
local original_keyboard
local fields = {
    "session", "state", "installed", "russian", "qa", "downloaded", "total", "version", "patch", "theme",
    "error", "caption", "message", "size_label", "action_label", "cancel_label", "disable_label", "qa_download"
}

local function read_field(key)
    local console = get_console()
    console:execute("ild_update read " .. key)
    return console:get_string("ild_update") or ""
end

local function read_status()
    local result = {}
    for _, key in ipairs(fields) do result[key] = read_field(key) end
    local chunks = {}
    for index = 0, 127 do
        local chunk = read_field("changes:" .. index)
        chunks[#chunks + 1] = chunk
        if #chunk < 240 then break end
    end
    result.changes = table.concat(chunks)
    status = result
    return status
end

local function command(action)
    get_console():execute("ild_update " .. action)
end

function i(menu)
    menu:InitControls()
    ui_main_menu.main_menu.Update = u
    if not original_keyboard then
        original_keyboard = ui_main_menu.main_menu.OnKeyboard
        ui_main_menu.main_menu.OnKeyboard = menu_keyboard
    end
end

function menu_keyboard(menu, dik, action)
    if menu.ild_update_visible then return menu.ild_update_dialog:OnKeyboard(dik, action) end
    return original_keyboard(menu, dik, action)
end

function u(menu)
    CUIScriptWnd.Update(menu)
    if menu.ild_update_visible then return end
    local now = tonumber(read_field("clock")) or 0
    if now < next_poll then return end
    next_poll = now + 250
    local current = read_status()
    if not current.session then return end
    if current.state ~= "available" and current.state ~= "major_available" then return end
    if menu.ild_update_dismissed == current.session .. ":" .. current.state then return end
    if not menu.ild_update_dialog then
        -- The holder is already iterating its dialogs here; attach a child instead.
        menu.ild_update_dialog = update_dialog()
        menu.ild_update_dialog.owner = menu
        menu.ild_update_dialog:SetAutoDelete(true)
        menu:AttachChild(menu.ild_update_dialog)
    end
    menu.ild_update_dialog:refresh(current)
    menu.ild_update_visible = true
    menu.shniaga:Enable(false)
    menu.shniaga:Show(false)
    menu.ild_update_dialog:Show(true)
end

class "update_dialog" (CUIScriptWnd)

function update_dialog:__init() super()
    self:Init(0, 0, 1024, 768)
    local xml = CScriptXmlInit()
    xml:ParseFile("ild_fixes_update.xml")
    xml:InitStatic("background", self)
    self.caption = xml:InitStatic("caption", self)
    self.message = xml:InitStatic("message", self)
    self.size = xml:InitStatic("size", self)
    self.theme = xml:InitStatic("theme", self)
    self.changes = xml:InitScrollView("changes", self)
    self.changes_text = xml:InitStatic("changes_text", nil)
    self.changes:AddWindow(self.changes_text, true)
    self.progress_text = xml:InitStatic("progress_text", self)
    self.progress_back = xml:InitStatic("progress_back", self)
    self.progress = xml:InitStatic("progress_fill", self)
    self.action = xml:Init3tButton("action", self)
    self.cancel = xml:Init3tButton("cancel", self)
    self.disable = xml:Init3tButton("disable", self)
    self:Register(self.action, "ild_action")
    self:Register(self.cancel, "ild_cancel")
    self:Register(self.disable, "ild_disable")
    self:AddCallback("ild_action", ui_events.BUTTON_CLICKED, self.on_action, self)
    self:AddCallback("ild_cancel", ui_events.BUTTON_CLICKED, self.on_cancel, self)
    self:AddCallback("ild_disable", ui_events.BUTTON_CLICKED, self.on_disable, self)
    self.next_poll = 0
end

function update_dialog:Update()
    CUIScriptWnd.Update(self)
    local now = tonumber(read_field("clock")) or 0
    if now < self.next_poll then return end
    self.next_poll = now + 250
    self:refresh(read_status())
    if self.qa_exit_at and now >= self.qa_exit_at then
        self.qa_exit_at = nil
        get_console():execute("quit")
    end
    if status.qa == "1" and self.qa_captured_state ~= self.state and
        (self.state == "available" or self.state == "ready") then
        if self.qa_capture_state ~= self.state then
            self.qa_capture_state = self.state
            self.qa_capture_at = now + 1000
        end
        if now >= self.qa_capture_at then
            self.qa_captured_state = self.state
            command("qa_ui_ready")
            if self.state == "available" and status.qa_download == "1" then self:on_action() end
            if self.state == "ready" and status.qa_download == "1" then self.qa_exit_at = now + 4000 end
        end
    end
end

function update_dialog:refresh(current)
    self.state = current.state
    self.caption:SetText(current.caption or "")
    self.message:SetText(current.message or "")
    self.size:SetText(current.size_label or "")
    self.theme:SetText(current.theme or "")
    local changes = current.changes or ""
    if changes ~= self.last_changes then
        self.last_changes = changes
        self.changes_text:SetText(changes)
        self.changes_text:AdjustHeightToText()
    end
    self.action:SetText(current.action_label or "")
    self.cancel:SetText(current.cancel_label or "")
    self.disable:SetText(current.disable_label or "")
    local progress = current.state == "downloading" or current.state == "ready"
    self.changes:Show(not progress)
    self.theme:Show(not progress)
    self.progress:Show(progress)
    self.progress_back:Show(progress)
    self.progress_text:Show(progress)
    self.disable:Show(current.state == "major_available")
    self.action:Enable(current.state ~= "downloading")
    self.cancel:Enable(current.state ~= "downloading" and current.state ~= "ready")
    local downloaded = tonumber(current.downloaded) or 0
    local total = tonumber(current.total) or 0
    local fraction = total > 0 and math.min(1, downloaded / total) or 0
    self.progress:Init(286, 414, 452 * fraction, 12)
    self.progress_text:SetText(string.format("%.2f / %.2f MiB", downloaded / 1048576, total / 1048576))
    if current.state == "apply_started" then get_console():execute("quit") end
    if current.state == "dismissed" or current.state == "current" then self:close() end
end

function update_dialog:on_action()
    if self.state == "major_available" then command("open_major")
    elseif self.state == "ready" then command("apply")
    else command("download") end
end

function update_dialog:on_cancel()
    if self.state == "downloading" or self.state == "ready" then return end
    command(self.state == "major_available" and "dismiss_major" or "dismiss")
    self:close()
end

function update_dialog:on_disable()
    command("disable_major")
    self:close()
end

function update_dialog:close()
    self.owner.ild_update_dismissed = (status.session or "") .. ":" .. (self.state or "")
    self:Show(false)
    self.owner.ild_update_visible = false
    self.owner.shniaga:Show(true)
    self.owner.shniaga:Enable(true)
end

function update_dialog:OnKeyboard(dik, action)
    CUIScriptWnd.OnKeyboard(self, dik, action)
    if action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then self:on_cancel() end
    return true
end
