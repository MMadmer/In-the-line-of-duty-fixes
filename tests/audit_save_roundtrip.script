local started
local written = false
local inspected = false
local mode
local failed = false

function install()
    local original = bind_stalker.actor_binder.update
    bind_stalker.actor_binder.update = function(self, delta)
        local restored_timestamp = self.st and self.st.disable_input_time
        original(self, delta)
        local console = get_console()
        console:execute("ild_update read clock")
        local now = tonumber(console:get_string("ild_update"))
        if not started then
            started = now
            console:execute("ild_update read qa_save_mode")
            mode = console:get_string("ild_update")
            console:execute("ild_update qa_game_ready")
        end
        if mode == "read" and not inspected then
            inspected = true
            if not restored_timestamp or self.st.disable_input_idle ~= 30 then
                failed = true
                console:execute("ild_update qa_fail timed-input-not-restored before=" ..
                    tostring(restored_timestamp) .. " idle=" .. tostring(self.st.disable_input_idle))
            else
                -- Exercise expiry immediately after verifying the original saved duration.
                self.st.disable_input_idle = 0
            end
        end
        if mode == "write" and not written and now - started >= 500 then
            written = true
            self.st.disable_input_time = game.get_game_time()
            self.st.disable_input_idle = 30
            level.disable_input()
            console:execute("save ild_audit_timed_input")
        end
        if now - started >= 5000 then
            if mode == "read" and self.st.disable_input_time then
                failed = true
                console:execute("ild_update qa_fail timed-input-not-expired")
            end
            if not failed then console:execute("ild_update qa_save_" .. mode) end
            console:execute("quit")
        end
    end
end
