using System;
using System.Reflection;

// The packaging scripts compare this Win32 product version with the CMake project version.
[assembly: AssemblyTitle("In the Line of Duty Fixes updater")]
[assembly: AssemblyInformationalVersion("@PROJECT_VERSION@")]

namespace IldFixes.Updater
{
    internal static class ProductInfo
    {
        internal const string VersionText = "@PROJECT_VERSION@";
        internal const string Repository = "MMadmer/In-the-line-of-duty-fixes";
        internal const string AssetPrefix = "In-the-line-of-duty-fixes-";
        internal static readonly Version Version = new Version(VersionText);
    }
}
